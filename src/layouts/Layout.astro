---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import MobileStickyCta from '../components/MobileStickyCta.astro';
import ExitIntentPopup, { type Props as ExitIntentPopupProps } from '../components/ExitIntentPopup.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  hideMobileCta?: boolean;
  hideFooterNewsletter?: boolean;
  /** Elrejti a sitewide exit intent popupot ezen az oldalon (pl. Kapcsolat, jogi oldalak). */
  hideExitIntent?: boolean;
  /** Felülírja a sitewide popup alapértelmezett copy-ját/céljait egy adott oldalon. */
  exitIntent?: Partial<ExitIntentPopupProps>;
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  noindex = false,
  type = 'website',
  hideMobileCta = false,
  hideFooterNewsletter = false,
  hideExitIntent = false,
  exitIntent,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImageURL = new URL(image, SITE.url);
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:site_name" content={SITE.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!--
      Analitika: Google Tag Manager — csak akkor töltjük be, ha a látogató elfogadta az analitikai
      sütiket (lásd src/lib/cookieConsent.ts, hasConsent('analytics'), CONSENT_CHANGE_EVENT).
      A GTM konténer (GTM-W738PN86) tartalmazza a GA4-konfigurációs taget a G-GGLX09K1VG mérési
      azonosítóra, ezért nem töltünk be külön gtag.js-t — az duplázná az eseményeket.
      A kiemelt CTA-gombok automatikusan `data-outbound="okoskonyha"` attribútummal és
      `trackOutboundClick` hívással jelzik az okoskonyha.akardosbalint.hu felé történő kattintást
      a dataLayerbe, lásd src/components/CTAButton.astro és src/lib/analytics.ts.
    -->
    <script>
      import { hideExpiredJoinCtas } from '../lib/joinDeadline';
      hideExpiredJoinCtas();
    </script>
    <script>
      import { hasConsent, CONSENT_CHANGE_EVENT } from '../lib/cookieConsent';

      function loadGTM() {
        if (document.querySelector('script[data-gtm-loaded]')) return;
        const script = document.createElement('script');
        script.dataset.gtmLoaded = 'true';
        script.innerHTML =
          "(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});" +
          "var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;" +
          "j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);" +
          "})(window,document,'script','dataLayer','GTM-W738PN86');";
        document.head.appendChild(script);
      }

      function updateAnalyticsConsent() {
        if (hasConsent('analytics')) {
          loadGTM();
        }
      }

      updateAnalyticsConsent();
      document.addEventListener(CONSENT_CHANGE_EVENT, updateAnalyticsConsent);
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-full focus:bg-forest-800 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-cream"
    >
      Ugrás a tartalomhoz
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer hideNewsletter={hideFooterNewsletter} />
    <CookieConsent />
    {!hideMobileCta && <MobileStickyCta />}
    <ExitIntentPopup enabled={!hideExitIntent} {...exitIntent} />
  </body>
</html>
