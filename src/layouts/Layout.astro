---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  image = '/og-default.jpg',
  noindex = false,
  type = 'website',
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImageURL = new URL(image, SITE.url);
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:site_name" content={SITE.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!--
      Analitika: illessz be ide tetszőleges nyomkövető kódot (pl. Google Analytics / Plausible).
      FONTOS (GDPR): a kódot csak akkor futtasd, ha a látogató elfogadta az analitikai sütiket —
      lásd src/lib/cookieConsent.ts (hasConsent('analytics'), CONSENT_CHANGE_EVENT).
      A kiemelt CTA-gombok automatikusan `data-outbound="okoskonyha"` attribútummal
      és `trackOutboundClick` hívással jelzik az okoskonyha.akardosbalint.hu felé történő kattintást,
      lásd src/components/CTAButton.astro és src/lib/analytics.ts.
    -->
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
