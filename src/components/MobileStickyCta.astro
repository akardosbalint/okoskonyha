---
import { SITE } from '../lib/site';
---

<div
  data-mobile-sticky-cta
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full px-3 pb-3 transition-transform duration-300 lg:hidden"
>
  <div class="mx-auto flex max-w-md items-center justify-between gap-3 rounded-full bg-forest-800 px-4 py-3 shadow-xl shadow-forest-900/30">
    <span class="text-sm font-semibold text-cream">Csatlakozz az Okoskonyhához</span>
    <a
      href={SITE.checkoutUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-outbound="okoskonyha"
      data-cta-label="mobile_sticky_bar"
      class="shrink-0 rounded-full bg-clay-500 px-4 py-2 text-sm font-heading font-semibold text-cream hover:bg-clay-600"
    >
      Csatlakozom →
    </a>
  </div>
</div>

<script>
  import { trackOutboundClick } from '../lib/analytics';

  const bar = document.querySelector<HTMLElement>('[data-mobile-sticky-cta]');
  const link = bar?.querySelector<HTMLAnchorElement>('a[data-outbound="okoskonyha"]');

  link?.addEventListener('click', () => {
    trackOutboundClick(link.href, link.dataset.ctaLabel ?? 'mobile_sticky_bar');
  });

  function updateVisibility() {
    if (!bar) return;
    const shouldShow = window.scrollY > window.innerHeight * 0.6;
    bar.classList.toggle('translate-y-full', !shouldShow);
  }

  window.addEventListener('scroll', updateVisibility, { passive: true });
  updateVisibility();
</script>
