<div
  data-mobile-sticky-cta
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full px-3 pb-3 transition-transform duration-300 lg:hidden"
>
  <div class="mx-auto flex max-w-md items-center justify-between gap-3 rounded-full bg-forest-800 px-4 py-3 shadow-xl shadow-forest-900/30">
    <span class="text-sm font-semibold text-cream">Csatlakozz az Okoskonyhához</span>
    <a
      href="/okoskonyha/"
      data-cta-label="mobile_sticky_bar"
      class="shrink-0 rounded-full bg-clay-600 px-4 py-3 text-sm font-heading font-semibold text-cream hover:bg-clay-700"
    >
      Csatlakozom →
    </a>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-sticky-cta]');
  const ccRoot = document.getElementById('cookie-consent');
  let cookieBannerOpen = ccRoot ? !ccRoot.classList.contains('hidden') : false;

  function updateVisibility() {
    if (!bar) return;
    const shouldShow = !cookieBannerOpen && window.scrollY > window.innerHeight * 0.6;
    bar.classList.toggle('translate-y-full', !shouldShow);
  }

  window.addEventListener('scroll', updateVisibility, { passive: true });
  document.addEventListener('cc:visibility', ((e: CustomEvent<{ visible: boolean }>) => {
    cookieBannerOpen = e.detail.visible;
    updateVisibility();
  }) as EventListener);
  updateVisibility();
</script>
