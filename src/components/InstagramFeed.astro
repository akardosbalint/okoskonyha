---
import { SITE } from '../lib/site';

interface Props {
  handle?: string;
}
const { handle = '@akardosbalint' } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-14 md:px-6">
  <div class="flex flex-col items-center gap-4 rounded-3xl bg-sage-100 px-6 py-10 text-center md:py-12">
    <h2 class="text-2xl md:text-3xl font-semibold text-forest-700">
      Kövess <span class="font-script text-clay-500">Instagramon</span>
    </h2>
    <p class="max-w-md text-forest-600">
      Napi konyhai pillanatok, kulisszák mögötti sztorik és friss receptötletek — {handle} alatt.
    </p>
    <a
      href={SITE.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 font-semibold text-clay-600 shadow-sm hover:text-clay-700 hover:shadow-md"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
      {handle}
    </a>
  </div>
</section>
