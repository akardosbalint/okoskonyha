---
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster: ImageMetadata;
  caption?: string;
}
const { src, poster, caption } = Astro.props;
---

<figure class="mx-auto w-full max-w-xs">
  <div class="overflow-hidden rounded-3xl shadow-lg shadow-forest-900/10">
    <video
      class="aspect-[4/5] w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster={poster.src}
    >
      <source src={src} type="video/mp4" />
    </video>
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-forest-500">{caption}</figcaption>}
</figure>
