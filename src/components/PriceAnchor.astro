---
import { PRICING } from '../lib/program';
---

<div class="text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-forest-500">{PRICING.programName} · {PRICING.durationLabel}</p>
  <p class="mt-2">
    <span class="text-2xl text-forest-400 line-through">{PRICING.regularPrice}</span>
  </p>
  <p class="font-heading text-5xl font-semibold text-forest-800">{PRICING.currentPrice}</p>
  <p class="mt-1 text-forest-500">({PRICING.weeklyEquivalent})</p>
</div>
