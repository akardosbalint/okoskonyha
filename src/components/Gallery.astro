---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}
const { images } = Astro.props;
---

<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4">
  {
    images.map((img, i) => (
      <div
        class:list={[
          'overflow-hidden rounded-2xl',
          i === 0 && 'col-span-2 row-span-2 sm:col-span-2 sm:row-span-2',
        ]}
      >
        <Image
          src={img.src}
          alt={img.alt}
          width={i === 0 ? 700 : 340}
          height={i === 0 ? 700 : 340}
          class="h-full w-full object-cover aspect-square transition-transform duration-500 hover:scale-105"
        />
      </div>
    ))
  }
</div>
