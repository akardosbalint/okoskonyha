---
import { SITE } from '../lib/site';
import { BIO_STATS } from '../lib/program';
import EmailSequenceChips from './EmailSequenceChips.astro';
import Icon from './Icon.astro';

interface Props {
  variant?: 'inline' | 'card' | 'dark-inline';
  eyebrow?: string;
  title?: string;
  description?: string;
}
const {
  variant = 'card',
  eyebrow = 'Mielőtt csatlakoznál',
  title = 'Eleged van az esti „mi legyen vacsira” fejtörésből?',
  description = '5 emailben pontosan megmutatom, hogyan főzöl majd finomabbat és egészségesebbet — olcsóbban és gyorsabban.',
} = Astro.props;

// A 'card' és a 'dark-inline' egyaránt sötét háttérre szánt, világos szöveggel — a különbség csak
// annyi, hogy a 'card' saját forest-700 dobozt kap, a 'dark-inline' egy már sötét szekcióba simul bele.
const isLightText = variant === 'card' || variant === 'dark-inline';

// Az 1200+ vendég ugyanaz a szám, ami a Rólam oldalon is szerepel (src/lib/program.ts) — nem új
// állítás, csak egy helyen tartva, hogy a bizonyíték mindenhol frissen és egyezően jelenjen meg.
const guestProof = BIO_STATS.find((stat) => stat.label.includes('vendég'));
---

<div class:list={[
  'rounded-3xl',
  variant === 'card' ? 'bg-forest-700 text-cream p-6 md:p-8' : 'bg-transparent',
]}>
  <p class:list={['font-script text-2xl mb-1', isLightText ? 'text-clay-300' : 'text-clay-500']}>{eyebrow}</p>
  <h3 class:list={['text-xl md:text-2xl font-semibold mb-2', isLightText ? 'text-cream' : 'text-forest-700']}>
    {title}
  </h3>
  <p class:list={['mb-4 text-sm md:text-base', isLightText ? 'text-sage-100/90' : 'text-forest-600']}>
    {description}
  </p>

  <div class:list={['mb-5 rounded-2xl p-4', isLightText ? 'bg-cream/10' : 'bg-sage-50']}>
    <EmailSequenceChips onDark={isLightText} />
  </div>

  {
    guestProof && (
      <p class:list={['mb-5 flex items-center gap-2 text-sm font-semibold', isLightText ? 'text-cream/90' : 'text-forest-700']}>
        <Icon name="chat" class="h-4 w-4 shrink-0" />
        {guestProof.value} vendég ismerte már meg élőben ezt a rendszert
      </p>
    )
  }

  <form
    data-newsletter-form
    data-endpoint={SITE.newsletterEndpoint}
    method="post"
  >
    <div class="flex flex-col gap-3 sm:flex-row">
      <label for="newsletter-email" class="sr-only">E-mail cím</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        required
        placeholder="te@email.hu"
        class="flex-1 rounded-full border-0 px-5 py-3 text-forest-800 placeholder:text-forest-400 focus:outline-none focus:ring-2 focus:ring-clay-500"
      />
      <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button
        type="submit"
        class="rounded-full bg-clay-600 px-6 py-3 font-heading font-semibold text-cream transition-colors hover:bg-clay-700 whitespace-nowrap"
      >
        Kérem az első tippet
      </button>
    </div>
    <label class:list={['mt-3 flex items-start gap-2 text-sm', isLightText ? 'text-cream/80' : 'text-forest-600']}>
      <input type="checkbox" name="privacyConsent" required class="mt-0.5 h-4 w-4 shrink-0 accent-clay-500" />
      <span>
        Elfogadom, hogy az e-mail címemet az 5 részes levélsorozat (és az azt követő alkalmi hírlevél) küldése céljából kezeljék. Bővebben az <a href="/adatvedelem/" class:list={['underline', isLightText ? 'text-cream hover:text-clay-300' : 'text-clay-600 hover:text-clay-700']}>Adatvédelmi tájékoztatóban</a>.
      </span>
    </label>
    <p class:list={['mt-2 text-xs', isLightText ? 'text-cream/60' : 'text-forest-400']}>
      Ingyenes és azonnali — nem a fizetős Okoskonyha tagság. Nincs spam, egy kattintással leiratkozhatsz.
    </p>
  </form>
  <p data-newsletter-message class:list={['mt-3 text-sm', isLightText ? 'text-cream' : 'text-forest-700']} role="status"></p>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const honeypot = form.querySelector<HTMLInputElement>('input[name="company"]');
      const message = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-message]');
      if (honeypot?.value) return; // valószínűleg spam bot, csendben eldobjuk

      const email = form.querySelector<HTMLInputElement>('input[name="email"]')?.value;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const endpoint = form.dataset.endpoint;
      if (!email || !message || !button) return;

      if (!endpoint) {
        message.textContent =
          'A feliratkozás hamarosan aktiválódik — addig is írj bátran a hello@akardosbalint.hu címre!';
        return;
      }

      button.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (res.ok) {
          message.textContent = 'Köszönjük! Nézd meg a postaládád — hamarosan jön az első levél.';
          form.reset();
        } else {
          message.textContent = 'Hoppá, valami elakadt. Próbáld újra, vagy írj a hello@akardosbalint.hu címre.';
        }
      } catch {
        message.textContent = 'Hoppá, valami elakadt. Próbáld újra, vagy írj a hello@akardosbalint.hu címre.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
