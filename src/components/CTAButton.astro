---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  outbound?: boolean;
  class?: string;
  // Stabil analitikai azonosító a látható gombszövegtől függetlenül — enélkül ugyanaz a
  // funnel-lépés ("csatlakozás") a "Csatlakozom" / "Csatlakozom most" / "Csatlakozom az
  // Okoskonyhához" változatok miatt külön eseménycímke alatt futna GTM/GA4-ben.
  trackingId?: string;
}

const {
  href,
  label,
  variant = 'primary',
  size = 'md',
  outbound = false,
  class: className = '',
  trackingId,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-heading font-semibold transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest-700';

const variants: Record<string, string> = {
  primary: 'bg-clay-600 text-cream hover:bg-clay-700 shadow-lg shadow-clay-500/30',
  secondary: 'bg-forest-700 text-cream hover:bg-forest-600',
  ghost: 'bg-white/80 text-forest-700 hover:bg-white border-2 border-forest-700/20',
};

const sizes: Record<string, string> = {
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const isExternal = href.startsWith('http');
---

<a
  href={href}
  class={`${base} ${variants[variant]} ${sizes[size]} ${className}`}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  data-outbound={outbound ? 'okoskonyha' : undefined}
  data-cta-label={trackingId ?? label}
>
  {label}
  <span aria-hidden="true">→</span>
</a>

{
  outbound && (
    <script>
      import { trackOutboundClick } from '../lib/analytics';
      document
        .querySelectorAll<HTMLAnchorElement>('[data-outbound="okoskonyha"]:not([data-tracked])')
        .forEach((el) => {
          el.dataset.tracked = 'true';
          el.addEventListener('click', () => {
            trackOutboundClick(el.href, el.dataset.ctaLabel ?? 'okoskonyha_cta');
          });
        });
    </script>
  )
}
