---
import CTAButton from './CTAButton.astro';
import { PRICING } from '../lib/program';
import { SITE } from '../lib/site';
---

<div class="grid gap-6 md:grid-cols-2 md:max-w-3xl md:mx-auto">
  <div class="rounded-3xl bg-white p-8 shadow-md text-forest-800">
    <h3 class="font-heading text-xl font-semibold mb-1">Havi tagság</h3>
    <p class="text-sm text-forest-500 mb-6">Ismerd meg a közösséget, nincs hosszú távú elköteleződés.</p>
    <p class="mb-6">
      <span class="text-4xl font-heading font-semibold">{PRICING.monthly.price}</span>
      <span class="text-sm text-forest-500"> {PRICING.monthly.period}</span>
    </p>
    <CTAButton href={SITE.circleUrl} label="Csatlakozom" variant="secondary" outbound />
  </div>
  <div class="rounded-3xl bg-forest-700 p-8 shadow-xl text-cream scale-[1.02]">
    <span class="mb-3 inline-block w-fit rounded-full bg-clay-500 px-3 py-1 text-xs font-semibold text-cream">
      Legnépszerűbb
    </span>
    <h3 class="font-heading text-xl font-semibold mb-1">Éves tagság</h3>
    <p class="text-sm text-sage-100/80 mb-6">A leggazdaságosabb választás, ha komolyan belevágnál.</p>
    <p class="mb-6">
      <span class="text-4xl font-heading font-semibold">{PRICING.annual.price}</span>
      <span class="text-sm text-sage-100/80"> {PRICING.annual.period}</span>
    </p>
    <CTAButton href={SITE.circleUrl} label="Csatlakozom" variant="primary" outbound />
  </div>
</div>
<p class="mt-6 text-center text-sm text-forest-500">{PRICING.priceNote}</p>
