---
import CTAButton from './CTAButton.astro';
import { PRICING } from '../lib/program';
import { SITE } from '../lib/site';
---

<p class="mb-6 text-center">
  <span class="inline-block rounded-full bg-clay-500/10 px-4 py-1.5 text-sm font-semibold text-clay-600">
    {PRICING.introOffer}
  </span>
</p>

<div class="grid gap-6 md:grid-cols-2 md:max-w-3xl md:mx-auto">
  <div class="rounded-3xl bg-white p-8 shadow-md text-forest-800">
    <h3 class="font-heading text-xl font-semibold mb-1">{PRICING.monthly.label}</h3>
    <p class="text-sm text-forest-500 mb-6">Ismerd meg a közösséget, nincs hosszú távú elköteleződés.</p>
    <p class="mb-1">
      <span class="text-4xl font-heading font-semibold">{PRICING.monthly.price}</span>
      <span class="text-sm text-forest-500"> {PRICING.monthly.period}</span>
    </p>
    <p class="mb-1 text-sm text-forest-500">({PRICING.monthly.dailyEquivalent})</p>
    <p class="mb-6 text-sm font-semibold text-clay-600">
      {PRICING.lockedInNote}
    </p>
    <CTAButton href={SITE.checkoutUrl} label="Csatlakozom" variant="secondary" outbound trackingId="join_cta_monthly" hideAfterDeadline />
    <p class="mt-3 text-xs text-forest-500">3 napos ingyenes próba, bankkártyával — próbaidő alatt bármikor lemondható.</p>
  </div>
  <div class="rounded-3xl bg-forest-700 p-8 shadow-xl text-cream scale-[1.02]">
    <span class="mb-3 inline-block w-fit rounded-full bg-clay-600 px-3 py-1 text-xs font-semibold text-cream">
      Leggazdaságosabb
    </span>
    <h3 class="font-heading text-xl font-semibold mb-1 text-cream">{PRICING.annual.label}</h3>
    <p class="text-sm text-sage-100/80 mb-6">A leggazdaságosabb választás, ha komolyan belevágnál.</p>
    <p class="mb-1">
      <span class="text-4xl font-heading font-semibold">{PRICING.annual.price}</span>
      <span class="text-sm text-sage-100/80"> {PRICING.annual.period}</span>
    </p>
    <p class="mb-1 text-sm text-sage-100/80">({PRICING.annual.dailyEquivalent})</p>
    <p class="mb-6 text-sm font-semibold text-clay-300">
      {PRICING.lockedInNote}
    </p>
    <CTAButton href={SITE.checkoutUrl} label="Csatlakozom" variant="primary" outbound trackingId="join_cta_annual" hideAfterDeadline />
    <p class="mt-3 text-xs text-sage-100/80">3 napos ingyenes próba, bankkártyával — próbaidő alatt bármikor lemondható.</p>
  </div>
</div>
<p class="mt-6 text-center text-sm text-forest-500">
  {PRICING.futureNoteIntro} {PRICING.monthly.futurePrice} {PRICING.monthly.period} (+{PRICING.monthly.increasePercent}),
  illetve {PRICING.annual.futurePrice} {PRICING.annual.period} (+{PRICING.annual.increasePercent}).
</p>
<p class="mt-3 text-center text-sm text-forest-500">{PRICING.priceNote}</p>
<p class="mt-2 text-center text-xs text-forest-500">{PRICING.billingNote}</p>
