---
import { VALUE_STACK, PRICING } from '../lib/program';
---

<div class="overflow-hidden rounded-3xl bg-white shadow-lg shadow-forest-900/5">
  <ul class="divide-y divide-sage-100">
    {
      VALUE_STACK.map((row) => (
        <li class="flex items-center justify-between gap-4 px-6 py-4">
          <span class="text-forest-700">{row.item}</span>
          <span class="shrink-0 font-heading font-semibold text-forest-800">{row.value}</span>
        </li>
      ))
    }
  </ul>
  <div class="flex items-center justify-between gap-4 bg-forest-700 px-6 py-4">
    <span class="font-heading font-semibold text-cream">Összesen</span>
    <span class="font-heading text-xl font-semibold text-cream">{PRICING.totalValue}</span>
  </div>
</div>
