---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { BLOG_CATEGORIES } from '../lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const category = BLOG_CATEGORIES[post.data.category];
const formattedDate = post.data.date.toLocaleDateString('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' });
const searchIndex = [post.data.title, post.data.excerpt, post.data.category, ...post.data.tags]
  .join(' ')
  .toLowerCase();
---

<a
  href={`/blog/${post.slug}/`}
  data-blog-card
  data-search-index={searchIndex}
  class:list={[
    'group flex flex-col overflow-hidden rounded-3xl bg-white shadow-md shadow-forest-900/5 transition-shadow hover:shadow-xl',
    featured && 'md:col-span-2 md:flex-row',
  ]}
>
  <div class:list={['overflow-hidden', featured ? 'md:w-1/2' : 'aspect-[3/2]']}>
    <Image
      src={post.data.cover}
      alt={post.data.coverAlt}
      width={featured ? 700 : 500}
      height={featured ? 500 : 340}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class:list={['flex flex-1 flex-col p-6', featured && 'md:p-8 md:justify-center']}>
    <span class="mb-2 inline-block w-fit rounded-full bg-sage-100 px-3 py-1 text-xs font-semibold text-forest-700">
      {category?.label ?? post.data.category}
    </span>
    <h3 class:list={['font-heading font-semibold text-forest-800 group-hover:text-clay-600 transition-colors', featured ? 'text-2xl md:text-3xl mb-3' : 'text-lg mb-2']}>
      {post.data.title}
    </h3>
    <p class:list={['text-forest-600 mb-4', featured ? 'text-base' : 'text-sm line-clamp-3']}>{post.data.excerpt}</p>
    <p class="mt-auto text-xs text-forest-400">{formattedDate}</p>
  </div>
</a>
