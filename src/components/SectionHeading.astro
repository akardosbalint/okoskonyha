---
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  align?: 'left' | 'center';
  light?: boolean;
}
const { eyebrow, title, accent, align = 'center', light = false } = Astro.props;
---

<div class:list={['mb-10', align === 'center' ? 'text-center' : 'text-left']}>
  {
    eyebrow && (
      <p class:list={['font-script text-2xl mb-1', light ? 'text-sage-200' : 'text-clay-500']}>{eyebrow}</p>
    )
  }
  <div class:list={['mb-3 flex', align === 'center' ? 'justify-center' : 'justify-start']} aria-hidden="true">
    <svg width="60" height="20" viewBox="0 0 60 20" fill="none">
      <path d="M2 10 Q 12 -4, 22 10 T 42 10 T 58 10" stroke={light ? '#fdfbf5' : '#bd6631'} stroke-width="2.5" stroke-linecap="round"/>
    </svg>
  </div>
  <h2 class:list={['text-3xl md:text-4xl font-semibold', light ? 'text-cream' : 'text-forest-700']}>
    {title} {accent && <span class="font-script text-clay-500">{accent}</span>}
  </h2>
</div>
