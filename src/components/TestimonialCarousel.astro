---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from './SectionHeading.astro';

interface TestimonialItem {
  name: string;
  role: string;
  quote: string;
  avatar?: ImageMetadata;
}

interface Props {
  items: TestimonialItem[];
  title?: string;
  accent?: string;
  eyebrow?: string;
}

const {
  items,
  title = 'A korábbi vendégeim',
  accent = 'élménybeszámolói',
  eyebrow,
} = Astro.props;
---

<section class="bg-sage-300 py-16 md:py-24 relative overflow-hidden">
  <div
    class="absolute -left-24 top-1/3 h-72 w-72 rounded-full bg-sage-400/40 blur-2xl"
    aria-hidden="true"
  >
  </div>
  <div class="mx-auto max-w-6xl px-4 md:px-6 relative">
    <SectionHeading eyebrow={eyebrow} title={title} accent={accent} />

    <div class="flex items-center gap-2 md:gap-4" data-testimonial-carousel>
      <button
        type="button"
        data-carousel-prev
        aria-label="Előző vélemény"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-forest-700 shadow-lg shadow-forest-900/10 transition-colors hover:bg-sage-100 md:h-12 md:w-12"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <div data-carousel-track class="flex min-w-0 flex-1 gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 no-scrollbar">
        {
          items.map((t) => (
            <div class="snap-start shrink-0 w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
              <figure class="flex h-full flex-col justify-between rounded-3xl bg-white p-6 md:p-7 shadow-lg shadow-forest-900/5">
                <blockquote class="italic text-forest-700 mb-6 leading-relaxed">"{t.quote}"</blockquote>
                <figcaption class="flex items-center gap-3">
                  {t.avatar && (
                    <Image
                      src={t.avatar}
                      alt={t.name}
                      width={56}
                      height={56}
                      class="h-14 w-14 rounded-full object-cover"
                    />
                  )}
                  <div>
                    <p class="font-heading font-semibold text-forest-800">{t.name}</p>
                    <p class="text-sm text-sage-600 font-medium">{t.role}</p>
                  </div>
                </figcaption>
              </figure>
            </div>
          ))
        }
      </div>

      <button
        type="button"
        data-carousel-next
        aria-label="Következő vélemény"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-forest-700 shadow-lg shadow-forest-900/10 transition-colors hover:bg-sage-100 md:h-12 md:w-12"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    scrollbar-width: none;
  }
</style>

<script>
  const AUTO_ADVANCE_MS = 5000;

  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prevBtn || !nextBtn) return;

    const cards = Array.from(track.children) as HTMLElement[];
    if (cards.length < 2) {
      prevBtn.hidden = true;
      nextBtn.hidden = true;
      return;
    }

    let current = 0;

    function goTo(index: number) {
      current = ((index % cards.length) + cards.length) % cards.length;
      cards[current].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
    }

    let timer = window.setInterval(() => goTo(current + 1), AUTO_ADVANCE_MS);

    function restartTimer() {
      window.clearInterval(timer);
      timer = window.setInterval(() => goTo(current + 1), AUTO_ADVANCE_MS);
    }

    nextBtn.addEventListener('click', () => {
      goTo(current + 1);
      restartTimer();
    });
    prevBtn.addEventListener('click', () => {
      goTo(current - 1);
      restartTimer();
    });

    root.addEventListener('mouseenter', () => window.clearInterval(timer));
    root.addEventListener('mouseleave', restartTimer);
    root.addEventListener('focusin', () => window.clearInterval(timer));
    root.addEventListener('focusout', restartTimer);
  }

  document.querySelectorAll<HTMLElement>('[data-testimonial-carousel]').forEach(initCarousel);
</script>
