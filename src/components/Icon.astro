---
type IconName = 'leaf' | 'video' | 'chat' | 'calendar' | 'gift' | 'book';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = 'h-7 w-7' } = Astro.props;

const paths: Record<IconName, string> = {
  leaf: 'M5 21c0-9 6-15 14-15 0 9-6 15-14 15Zm0 0c2-3 4-5 9-8',
  video: 'M3 7a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Zm13 3 5-3v10l-5-3',
  chat: 'M4 5h16v10H8l-4 4V5Z',
  calendar: 'M4 5h16v16H4V5Zm0 5h16M8 3v4M16 3v4',
  gift: 'M4 9h16v11H4V9Zm-1-4h18v4H3V5Zm9 0v15M12 5C10 5 9 3 7 3S4 5 6 7h6Zm0 0c2 0 3-2 5-2s3 2 1 4h-6Z',
  book: 'M4 5c3-1.5 6-1.5 8 0 2-1.5 5-1.5 8 0v14c-3-1.5-6-1.5-8 0-2-1.5-5-1.5-8 0V5Zm8 0v14',
};
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]} />
</svg>
