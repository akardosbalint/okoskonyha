---
import { NAV, SITE } from '../lib/site';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-cream/90 backdrop-blur border-b border-forest-700/10">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-6">
    <a href="/" class="font-heading text-xl font-semibold text-forest-700">
      Kardos <span class="font-script text-2xl text-clay-500">Bálint</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
              item.highlight
                ? 'bg-sage-300 text-forest-800 hover:bg-sage-400'
                : isActive(item.href)
                  ? 'text-clay-600'
                  : 'text-forest-700 hover:text-clay-600',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={SITE.checkoutUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-outbound="okoskonyha"
      data-cta-label="header_csatlakozom"
      class="hidden lg:inline-flex rounded-full bg-clay-600 px-5 py-2.5 text-sm font-heading font-semibold text-cream shadow-md shadow-clay-500/30 transition-transform hover:-translate-y-0.5 hover:bg-clay-700"
    >
      Csatlakozom →
    </a>

    <button
      id="menu-toggle"
      class="lg:hidden rounded-lg p-2 text-forest-700"
      aria-label="Menü megnyitása"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden lg:hidden border-t border-forest-700/10 bg-cream px-4 pb-4">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block rounded-lg px-3 py-3 text-base font-semibold',
            item.highlight ? 'text-clay-600' : 'text-forest-700',
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={SITE.checkoutUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-outbound="okoskonyha"
      data-cta-label="mobile_menu_csatlakozom"
      class="mt-2 block rounded-full bg-clay-600 px-5 py-3 text-center font-heading font-semibold text-cream"
    >
      Csatlakozom az Okoskonyhához →
    </a>
  </nav>
</header>

<script>
  import { trackOutboundClick } from '../lib/analytics';

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-outbound="okoskonyha"]:not([data-tracked])').forEach((el) => {
    el.dataset.tracked = 'true';
    el.addEventListener('click', () => trackOutboundClick(el.href, el.dataset.ctaLabel ?? 'header'));
  });
</script>
