---
// Kliensoldali keresés a már kirenderelt kártyák között (cím, kivonat, címkék alapján).
---

<div class="mb-8">
  <label for="blog-search" class="sr-only">Keresés a blogban</label>
  <div class="relative max-w-md">
    <input
      id="blog-search"
      type="search"
      placeholder="Keresés a blogban… (pl. fokhagyma, jótékonyság)"
      class="w-full rounded-full border-2 border-sage-200 bg-white px-5 py-3 pl-11 text-forest-800 placeholder:text-forest-400 focus:border-clay-500 focus:outline-none"
      data-blog-search
    />
    <svg
      class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-forest-400"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
  </div>
  <p data-blog-search-empty class="mt-4 hidden text-forest-500">
    Nincs találat. Próbálj más kulcsszót, vagy nézd meg az összes bejegyzést.
  </p>
</div>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-blog-search]');
  const emptyMessage = document.querySelector<HTMLElement>('[data-blog-search-empty]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-blog-card]'));

  // Ékezet-független keresés (pl. "fokhagyma" is találjon rá a "fokhagymás"-ra).
  const foldAccents = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  input?.addEventListener('input', () => {
    const query = foldAccents(input.value.trim());
    let visibleCount = 0;
    cards.forEach((card) => {
      const haystack = foldAccents(card.dataset.searchIndex ?? '');
      const match = query === '' || haystack.includes(query);
      card.classList.toggle('hidden', !match);
      if (match) visibleCount++;
    });
    emptyMessage?.classList.toggle('hidden', visibleCount > 0);
  });
</script>
