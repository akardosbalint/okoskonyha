---
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="flex items-center gap-3">
  <span class="text-sm font-semibold text-forest-600">Megosztás:</span>
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Megosztás Facebookon"
    class="rounded-full bg-sage-100 p-2 text-forest-700 hover:bg-sage-200"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
    </svg>
  </a>
  <a
    href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Megosztás WhatsAppon"
    class="rounded-full bg-sage-100 p-2 text-forest-700 hover:bg-sage-200"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </svg>
  </a>
  <button
    data-copy-link={url}
    aria-label="Link másolása"
    class="rounded-full bg-sage-100 p-2 text-forest-700 hover:bg-sage-200"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="9" y="9" width="13" height="13" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
  </button>
  <p data-copy-link-status class="sr-only" role="status" aria-live="polite"></p>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-link-status]');
    btn.addEventListener('click', async () => {
      const link = btn.dataset.copyLink;
      if (!link) return;
      try {
        await navigator.clipboard.writeText(link);
        const original = btn.innerHTML;
        const originalLabel = btn.getAttribute('aria-label') ?? 'Link másolása';
        btn.textContent = '✓';
        btn.setAttribute('aria-label', 'Link vágólapra másolva');
        if (status) status.textContent = 'Link vágólapra másolva.';
        setTimeout(() => {
          btn.innerHTML = original;
          btn.setAttribute('aria-label', originalLabel);
        }, 1500);
      } catch {
        // clipboard API elérhetetlen, csendben nem csinálunk semmit
      }
    });
  });
</script>
