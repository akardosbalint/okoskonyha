---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const DAYS = [
  {
    day: 'Vasárnap',
    duration: '~2 óra',
    icon: 'basket' as const,
    title: 'A heti nagy főzés',
    text: 'Egyszerre elkészíted a hét alapjait: 3 gabonát/köretet, 3 fehérjeforrást, 3 szószt és 1 friss salátát — ebből épül fel majd szinte minden étkezésed.',
  },
  {
    day: 'Hétfő – Kedd',
    duration: '~10 perc',
    icon: 'clock' as const,
    title: 'Villámgyors összeállítás',
    text: 'Nincs főzés, csak válogatás és tálalás — a hétvégén elkészített elemekből percek alatt összeáll az ebéd vagy vacsora.',
  },
  {
    day: 'Szerda',
    duration: '~30-45 perc',
    icon: 'calendar' as const,
    title: 'Egy frissítő közjáték',
    text: 'A hét közepén egy rövid, könnyed főzés hoz új ízeket az asztalra — hogy a hét végéig se legyen egyhangú, amit eszel.',
  },
  {
    day: 'Csütörtök – Vasárnap',
    duration: '~10 perc',
    icon: 'plate' as const,
    title: 'Ugyanaz a könnyedség',
    text: 'A jól címkézett, adagolt dobozok kitartanak a hét végéig — semmi nem vész el, semmi nem megy kárba.',
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
  <SectionHeading eyebrow="Nem csak ígéret" title="Hogy néz ki egy heted" accent="miután csatlakozol" />
  <p class="mx-auto -mt-6 mb-10 max-w-2xl text-center text-forest-600">
    Se esti kapkodás, se receptek közötti tanakodás — csak egy <strong class="font-semibold text-forest-800">ismételhető
    ritmus</strong>, amit egyszer megtanulsz, aztán soha többé nem kell újragondolnod.
  </p>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      DAYS.map((step) => (
        <div class="rounded-3xl bg-white p-6 shadow-sm shadow-forest-900/5">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-sage-100 text-forest-700">
            <Icon name={step.icon} class="h-6 w-6" />
          </div>
          <p class="text-sm font-semibold text-clay-600">{step.day} · {step.duration}</p>
          <h3 class="font-heading text-lg font-semibold text-forest-800 mt-1 mb-1">{step.title}</h3>
          <p class="text-sm text-forest-600">{step.text}</p>
        </div>
      ))
    }
  </div>
</section>
