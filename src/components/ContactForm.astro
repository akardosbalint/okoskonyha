---
import { SITE } from '../lib/site';
---

<form class="space-y-5" data-contact-form data-endpoint={SITE.contactEndpoint} method="post">
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="mb-1.5 block text-sm font-semibold text-forest-700">Név</label>
      <input
        id="contact-name"
        name="name"
        type="text"
        required
        class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
      />
    </div>
    <div>
      <label for="contact-email" class="mb-1.5 block text-sm font-semibold text-forest-700">E-mail cím</label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
      />
    </div>
  </div>

  <div>
    <label for="contact-topic" class="mb-1.5 block text-sm font-semibold text-forest-700">Miben segíthetek?</label>
    <select
      id="contact-topic"
      name="topic"
      class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
    >
      <option>Privát séfkedés</option>
      <option>Jótékonysági vacsora szervezése</option>
      <option>Okoskonyha tagság</option>
      <option>Életmód-tanácsadás</option>
      <option>Egyéb</option>
    </select>
  </div>

  <div>
    <label for="contact-message" class="mb-1.5 block text-sm font-semibold text-forest-700">Üzeneted</label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="5"
      class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
    ></textarea>
  </div>

  <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <label class="flex items-start gap-3 text-sm text-forest-600">
    <input
      type="checkbox"
      name="privacyConsent"
      required
      class="mt-0.5 h-4 w-4 shrink-0 accent-clay-500"
    />
    <span>
      Elfogadom, hogy a fenti adataimat Kardos Bálint a megkeresésem megválaszolása céljából kezelje. Bővebben az
      <a href="/adatvedelem/" class="text-clay-500 underline hover:text-clay-600">Adatvédelmi tájékoztatóban</a>.
    </span>
  </label>

  <button
    type="submit"
    class="w-full rounded-full bg-clay-500 px-6 py-3.5 font-heading font-semibold text-cream transition-colors hover:bg-clay-600 sm:w-auto"
  >
    Üzenet küldése
  </button>
  <p data-contact-message class="text-sm" role="status"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const honeypot = form.querySelector<HTMLInputElement>('input[name="company"]');
      const message = form.querySelector<HTMLElement>('[data-contact-message]');
      if (honeypot?.value) return;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const endpoint = form.dataset.endpoint;
      if (!message || !button) return;

      if (!endpoint) {
        message.textContent = 'Az űrlap hamarosan aktiválódik — addig is írj közvetlenül a hello@akardosbalint.hu címre!';
        return;
      }

      const formData = new FormData(form);
      button.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(formData)),
        });
        if (res.ok) {
          message.textContent = 'Köszönöm az üzeneted! Hamarosan válaszolok.';
          form.reset();
        } else {
          message.textContent = 'Hoppá, valami elakadt. Próbáld újra, vagy írj a hello@akardosbalint.hu címre.';
        }
      } catch {
        message.textContent = 'Hoppá, valami elakadt. Próbáld újra, vagy írj a hello@akardosbalint.hu címre.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
