---
---

<form class="space-y-5" data-contact-form method="post">
  <p class="text-xs text-forest-500">A csillaggal (*) jelölt mezők kitöltése kötelező.</p>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="mb-1.5 block text-sm font-semibold text-forest-700">Név <span class="text-clay-600" aria-hidden="true">*</span></label>
      <input
        id="contact-name"
        name="name"
        type="text"
        required
        class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
      />
    </div>
    <div>
      <label for="contact-email" class="mb-1.5 block text-sm font-semibold text-forest-700">E-mail cím <span class="text-clay-600" aria-hidden="true">*</span></label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
      />
    </div>
  </div>

  <div>
    <label for="contact-topic" class="mb-1.5 block text-sm font-semibold text-forest-700">Miben segíthetek? <span class="text-clay-600" aria-hidden="true">*</span></label>
    <select
      id="contact-topic"
      name="topic"
      required
      class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
    >
      <option value="" selected disabled>Válassz egy témát</option>
      <option>Privát séfkedés</option>
      <option>Jótékonysági vacsora szervezése</option>
      <option>Okoskonyha tagság</option>
      <option>Életmód-tanácsadás</option>
      <option>Egyéb</option>
    </select>
  </div>

  <div>
    <label for="contact-message" class="mb-1.5 block text-sm font-semibold text-forest-700">Üzeneted <span class="text-clay-600" aria-hidden="true">*</span></label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="5"
      class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
    ></textarea>
  </div>

  <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <label class="flex items-start gap-3 text-sm text-forest-600">
    <input
      type="checkbox"
      name="privacyConsent"
      required
      class="mt-0.5 h-4 w-4 shrink-0 accent-clay-500"
    />
    <span>
      Elfogadom, hogy a fenti adataimat Kardos Bálint a megkeresésem megválaszolása céljából kezelje. Bővebben az
      <a href="/adatvedelem/" class="text-clay-600 underline hover:text-clay-700">Adatvédelmi tájékoztatóban</a>.
      <span class="text-clay-600" aria-hidden="true">*</span>
    </span>
  </label>

  <button
    type="submit"
    class="w-full rounded-full bg-clay-600 px-6 py-3.5 font-heading font-semibold text-cream transition-colors hover:bg-clay-700 sm:w-auto"
  >
    Üzenet küldése
  </button>
  <div data-contact-message role="status"></div>
</form>

<script>
  import { SITE } from '../lib/site';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const honeypot = form.querySelector<HTMLInputElement>('input[name="company"]');
      const message = form.querySelector<HTMLElement>('[data-contact-message]');
      if (honeypot?.value) return;
      if (!message) return;

      const name = form.querySelector<HTMLInputElement>('#contact-name')?.value ?? '';
      const email = form.querySelector<HTMLInputElement>('#contact-email')?.value ?? '';
      const topic = form.querySelector<HTMLSelectElement>('#contact-topic')?.value ?? '';
      const userMessage = form.querySelector<HTMLTextAreaElement>('#contact-message')?.value ?? '';
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      const showSuccess = (text: string) => {
        message.className =
          'flex items-center gap-3 rounded-2xl border-2 border-sage-300 bg-sage-50 px-5 py-4 text-base font-semibold text-forest-700';
        message.innerHTML =
          '<svg class="h-6 w-6 shrink-0 text-forest-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>' +
          `<span>${text}</span>`;
      };
      const showError = (text: string) => {
        message.className = 'rounded-xl bg-clay-50 px-4 py-3 text-sm font-medium text-clay-700';
        message.textContent = text;
      };
      message.className = '';
      message.innerHTML = '';

      submitButton && (submitButton.disabled = true);
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, topic, message: userMessage, company: honeypot?.value ?? '' }),
        });

        if (res.ok) {
          if (Array.isArray(window.dataLayer)) {
            window.dataLayer.push({ event: 'contact_form_submit', topic });
          }
          showSuccess('Köszönjük az üzenetet! Hamarosan válaszolok.');
          form.reset();
        } else {
          showError(`Hoppá, valami elakadt. Próbáld újra, vagy írj közvetlenül a ${SITE.email} címre.`);
        }
      } catch {
        showError(`Hoppá, valami elakadt. Próbáld újra, vagy írj közvetlenül a ${SITE.email} címre.`);
      } finally {
        submitButton && (submitButton.disabled = false);
      }
    });
  });
</script>
