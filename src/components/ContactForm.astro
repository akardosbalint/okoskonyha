---
---

<form class="space-y-5" data-contact-form method="post">
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="mb-1.5 block text-sm font-semibold text-forest-700">Név</label>
      <input
        id="contact-name"
        name="name"
        type="text"
        required
        class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
      />
    </div>
    <div>
      <label for="contact-email" class="mb-1.5 block text-sm font-semibold text-forest-700">E-mail cím</label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
      />
    </div>
  </div>

  <div>
    <label for="contact-topic" class="mb-1.5 block text-sm font-semibold text-forest-700">Miben segíthetek?</label>
    <select
      id="contact-topic"
      name="topic"
      class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
    >
      <option>Privát séfkedés</option>
      <option>Jótékonysági vacsora szervezése</option>
      <option>Okoskonyha tagság</option>
      <option>Életmód-tanácsadás</option>
      <option>Egyéb</option>
    </select>
  </div>

  <div>
    <label for="contact-message" class="mb-1.5 block text-sm font-semibold text-forest-700">Üzeneted</label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="5"
      class="w-full rounded-xl border-2 border-sage-200 px-4 py-2.5 focus:border-clay-500 focus:outline-none"
    ></textarea>
  </div>

  <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <label class="flex items-start gap-3 text-sm text-forest-600">
    <input
      type="checkbox"
      name="privacyConsent"
      required
      class="mt-0.5 h-4 w-4 shrink-0 accent-clay-500"
    />
    <span>
      Elfogadom, hogy a fenti adataimat Kardos Bálint a megkeresésem megválaszolása céljából kezelje. Bővebben az
      <a href="/adatvedelem/" class="text-clay-600 underline hover:text-clay-700">Adatvédelmi tájékoztatóban</a>.
    </span>
  </label>

  <button
    type="submit"
    class="w-full rounded-full bg-clay-600 px-6 py-3.5 font-heading font-semibold text-cream transition-colors hover:bg-clay-700 sm:w-auto"
  >
    Üzenet küldése
  </button>
  <p data-contact-message class="text-sm" role="status"></p>
</form>

<script>
  import { SITE } from '../lib/site';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const honeypot = form.querySelector<HTMLInputElement>('input[name="company"]');
      const message = form.querySelector<HTMLElement>('[data-contact-message]');
      if (honeypot?.value) return;
      if (!message) return;

      const name = form.querySelector<HTMLInputElement>('#contact-name')?.value ?? '';
      const email = form.querySelector<HTMLInputElement>('#contact-email')?.value ?? '';
      const topic = form.querySelector<HTMLSelectElement>('#contact-topic')?.value ?? '';
      const userMessage = form.querySelector<HTMLTextAreaElement>('#contact-message')?.value ?? '';

      const subject = `Kapcsolatfelvétel a weboldalról — ${topic}`;
      const body = `Név: ${name}\nE-mail cím: ${email}\nTéma: ${topic}\n\nÜzenet:\n${userMessage}`;
      const mailtoUrl = `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      window.location.href = mailtoUrl;
      message.textContent =
        `Megnyitottuk az e-mail-kliensedet az üzeneteddel — kérlek, küldd el onnan! Ha nem történt semmi, írj közvetlenül a ${SITE.email} címre.`;
      form.reset();
    });
  });
</script>
