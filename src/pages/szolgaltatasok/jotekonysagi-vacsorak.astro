---
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Gallery from '../../components/Gallery.astro';
import StatsRow from '../../components/StatsRow.astro';
import { CHARITY_STATS } from '../../lib/program';
import g1 from '../../assets/photos/charity-dinner-menu.jpeg';
import g2 from '../../assets/photos/dinner-long-table.jpeg';
import g3 from '../../assets/photos/picnic-overhead.jpeg';

const galleryImages = [
  { src: g1, alt: 'Leves és kézzel írt menükártya egy jótékonysági pop-up vacsorán' },
  { src: g2, alt: 'Tizenkét vendég egy hosszú vacsoraasztal körül' },
  { src: g3, alt: 'Közös étkezés felülnézetből' },
];
---

<Layout
  title="Jótékonysági vacsorák — meghitt estek finom menüvel, valódi hatással"
  description="Adománygyűjtő vacsoraestek partnerszervezetekkel — jó társaság, finom növényi menü, valódi hatás."
>
  <section class="bg-sage-100 py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center md:px-6">
      <p class="font-script text-3xl text-clay-500 mb-2">Szolgáltatás</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-forest-700 mb-6">Jótékonysági vacsorák</h1>
      <p class="text-lg text-forest-600">
        Jellemzően 10–20 fős, meghitt vacsoraestek — mostantól akár 20 főig bővítve —, ahol egy finom
        növényi menü mellett egy konkrét jótékony ügyet támogatunk — partnerszervezettel, élő
        beszámolóval, és sokszor a vártnál nagyobb adományokkal.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <div class="prose-okos">
      <h2>Hogyan épül fel egy este?</h2>
      <ul>
        <li>Négyfogásos, teljesen növényi menü, gondosan megtervezett beszélgetés-indítókkal minden fogáshoz.</li>
        <li>Egy partnerszervezet képviselője élőben vagy videóhívásban mesél a támogatott ügyről.</li>
        <li>A vacsora ára tartalmaz egy alap adományrészt, a helyszínen pedig szabadon lehet további felajánlást tenni.</li>
        <li>Az este a desszert után nyitott beszélgetéssel zárul — sokan csak éjfél körül indulnak haza.</li>
      </ul>
      <h2>Kinek szervezem?</h2>
      <p>
        Magánszemélyeknek, akik szeretnének egy emlékezetes estét jó ügyért; cégeknek, amelyek csapatuknak
        szeretnének értékalapú élményt adni; és alapítványoknak, amelyek egy új, személyesebb formátumban
        szeretnék megszólítani a támogatóikat.
      </p>
      <h2>Partnerszervezet vagy?</h2>
      <p>
        Ha civil szervezetként szeretnétek egy vacsoraestet szervezni a támogatóitoknak, szívesen
        egyeztetek veletek a részletekről — a vendéglistától a történet felépítéséig.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
    <StatsRow stats={CHARITY_STATS} />
  </section>

  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="Korábbi estékből" title="Pillanatok az" accent="asztaloktól" />
      <Gallery images={galleryImages} />
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 text-center md:px-6">
    <h2 class="text-3xl font-semibold text-forest-700 mb-4">Szervezzünk egy estét együtt</h2>
    <p class="text-forest-600 mb-8">
      Mesélj a szervezetetekről vagy az alkalomról, amit terveztek — és kitaláljuk közösen a részleteket.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <CTAButton href="/kapcsolat/" label="Beszéljünk róla" size="lg" />
      <CTAButton href="/jotekonysag/" label="Eddigi eredményeink" variant="ghost" size="lg" />
    </div>
  </section>
</Layout>
