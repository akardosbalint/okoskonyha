---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import servicesHero from '../../assets/photos/food-tacos-catering.jpeg';
import { SITE } from '../../lib/site';

const services = [
  {
    href: '/szolgaltatasok/privat-sefkedes/',
    title: 'Privát séfkedés',
    description: 'Személyre szabott vacsorák otthonodban vagy céges rendezvényen — a menütervezéstől a felszolgálásig.',
    icon: 'M4 3h16M4 3v10a4 4 0 0 0 4 4M20 3v10a4 4 0 0 1-4 4m-4 0v7m-4 0h8',
  },
  {
    href: '/okoskonyha/',
    title: 'Okoskonyha',
    description: 'Fizetős online közösség recepteknek, élő beszélgetéseknek és havi kihívásoknak, a Circle.so-n.',
    icon: 'M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0M8 12h8M12 8v8',
    badge: 'Fő szolgáltatás',
  },
  {
    href: '/szolgaltatasok/jotekonysagi-vacsorak/',
    title: 'Jótékonysági vacsorák',
    description: 'Adománygyűjtő estek partnerszervezetekkel — az étel csak ürügy, a valódi cél a jótékony ügy.',
    icon: 'M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z',
  },
];
---

<Layout
  title="Szolgáltatások"
  description="Privát séfkedés, az Okoskonyha közösség és jótékonysági vacsorák Kardos Bálinttal."
>
  <section class="bg-sage-100 py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2 md:items-center md:px-6">
      <div>
        <p class="font-script text-3xl text-clay-500 mb-2">Amit kínálok</p>
        <h1 class="text-4xl md:text-5xl font-semibold text-forest-700 mb-6">
          Három út, <span class="font-script text-clay-500">egy cél</span>
        </h1>
        <p class="text-lg text-forest-600">
          Legyen szó egy privát vacsoráról, egy online közösségről vagy egy jótékonysági estéről — mindegyik
          arról szól, hogy az étel ürügy legyen valódi emberi kapcsolódásra.
        </p>
      </div>
      <Image src={servicesHero} alt="Tálalt tacók egy rendezvényen" width={600} height={600} class="w-full rounded-3xl object-cover aspect-square" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="grid gap-6 md:grid-cols-3">
      {
        services.map((service) => (
          <a
            href={service.href}
            class:list={[
              'group relative flex flex-col rounded-3xl p-8 shadow-md transition-shadow hover:shadow-xl',
              service.badge
                ? 'bg-forest-700 text-cream shadow-forest-900/20 ring-2 ring-clay-500 md:scale-105'
                : 'bg-white shadow-forest-900/5',
            ]}
          >
            {service.badge && (
              <span class="absolute -top-3 left-8 rounded-full bg-clay-500 px-4 py-1 text-xs font-semibold text-cream">
                {service.badge}
              </span>
            )}
            <div
              class:list={[
                'mb-4 flex h-14 w-14 items-center justify-center rounded-2xl',
                service.badge ? 'bg-cream/10 text-cream' : 'bg-sage-100 text-forest-700',
              ]}
            >
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d={service.icon} />
              </svg>
            </div>
            <h2
              class:list={[
                'font-heading text-xl font-semibold mb-2',
                service.badge ? 'text-cream' : 'text-forest-800 group-hover:text-clay-500',
              ]}
            >
              {service.title}
            </h2>
            <p class:list={['mb-4', service.badge ? 'text-cream/85' : 'text-forest-600']}>{service.description}</p>
            <span class:list={['mt-auto font-semibold', service.badge ? 'text-clay-300' : 'text-clay-500']}>Részletek →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 text-center md:px-6">
    <p class="text-forest-600 mb-6">Nem biztos, melyik illik hozzád? Beszéljünk róla.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <CTAButton href="/kapcsolat/" label="Írj üzenetet" size="lg" />
      <CTAButton href={SITE.circleUrl} label="Nézd meg az Okoskonyhát" variant="ghost" size="lg" outbound />
    </div>
  </section>
</Layout>
