---
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Gallery from '../../components/Gallery.astro';
import g1 from '../../assets/photos/balint-kitchen-prep.jpeg';
import g2 from '../../assets/photos/food-pasta-aglio-olio.jpeg';
import g3 from '../../assets/photos/food-baked-gratin.jpeg';

const galleryImages = [
  { src: g1, alt: 'Kardos Bálint séfkabátban a konyhában készíti az ételt' },
  { src: g2, alt: 'Tányér spagetti fokhagymás olívaolajjal, cukkinivel' },
  { src: g3, alt: 'Sült zöldséges gratin tepsiben' },
];

const steps = [
  { title: 'Ismerkedő beszélgetés', text: 'Rövid hívás vagy üzenetváltás: mi az alkalom, hányan lesztek, van-e allergia vagy különleges igény.' },
  { title: 'Személyre szabott menü', text: 'Összeállítok egy növényi menüt, ami illik az alkalomhoz és a vendégek ízléséhez.' },
  { title: 'A vacsora napja', text: 'Megérkezem, főzök a helyszínen, és a felszolgálás közben mesélek is az ételekről, ha szeretnéd.' },
  { title: 'Utóhang', text: 'A végén megosztom a kedvenc recepteket is, ha szeretnétek otthon újra elkészíteni.' },
];
---

<Layout
  title="Privát séfkedés — Növényi vacsora otthonodban vagy céges eseményen"
  description="Személyre szabott növényi vacsorák otthonodban vagy céges rendezvényen Kardos Bálinttal."
>
  <section class="bg-sage-100 py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center md:px-6">
      <p class="font-script text-3xl text-clay-500 mb-2">Szolgáltatás</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-forest-700 mb-6">Privát séfkedés</h1>
      <p class="text-lg text-forest-600">
        Szülinap, évforduló, céges csapatépítő vagy csak egy szombat este, amikor különlegesre vágysz —
        elviszem hozzátok a konyhámat, és egy növényi vacsorával teszem emlékezetessé az estét.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <div class="prose-okos">
      <h2>Kinek ajánlom?</h2>
      <p>
        Azoknak, akik szeretnének egy igazán különleges estét adni maguknak vagy szeretteiknek — legyen szó
        szűk családi körről, baráti társaságról vagy egy céges csapat számára szervezett vacsoráról. Nem kell
        vegánnak lenned ahhoz, hogy élvezd: a legtöbb vendégem mindenevő, és a végén mindig meglepődnek,
        mennyire jóllakottak és elégedettek egy teljesen növényi menütől.
      </p>
      <h2>Hogyan zajlik?</h2>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        steps.map((step, i) => (
          <div class="rounded-2xl bg-sage-50 p-6">
            <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-clay-500 text-sm font-semibold text-cream">
              {i + 1}
            </span>
            <h3 class="font-heading font-semibold text-forest-800 mb-1">{step.title}</h3>
            <p class="text-sm text-forest-600">{step.text}</p>
          </div>
        ))
      }
    </div>

    <div class="prose-okos mt-10">
      <h2>Mennyibe kerül?</h2>
      <p>
        Az ár a vendégek számától, a menü összetettségétől és a helyszíntől függ — ezért mindig egyedi
        árajánlatot adok egy rövid egyeztetés után. Iránymutatásként: egy 6–10 fős otthoni vacsora
        jellemzően egy éttermi háromfogásos menü árának felel meg, alapanyagokkal és a helyszíni főzéssel
        együtt.
      </p>
    </div>
  </section>

  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="Korábbi estékből" title="Egy kis" accent="ízelítő" />
      <Gallery images={galleryImages} />
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 text-center md:px-6">
    <h2 class="text-3xl font-semibold text-forest-700 mb-4">Foglaljuk le a dátumot</h2>
    <p class="text-forest-600 mb-8">Írj pár sort az alkalomról, és 48 órán belül válaszolok egy ajánlattal.</p>
    <CTAButton href="/kapcsolat/" label="Kérek árajánlatot" size="lg" />
  </section>
</Layout>
