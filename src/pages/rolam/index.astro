---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Gallery from '../../components/Gallery.astro';
import InstagramFeed from '../../components/InstagramFeed.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import heroImage from '../../assets/photos/balint-restaurant-portrait.jpeg';
import lifestyleMedicineCertificate from '../../assets/photos/lifestyle-medicine-certificate.jpeg';
import g1 from '../../assets/photos/event-candid-phone-photo.jpeg';
import g2 from '../../assets/photos/balint-restaurant-counter.jpeg';
import g3 from '../../assets/photos/event-outdoor-dining.jpeg';
import g4 from '../../assets/photos/food-spring-rolls-candid.jpeg';
import g5 from '../../assets/photos/event-balint-hosting.jpeg';
import g6 from '../../assets/photos/event-polaroids.jpeg';
import { SITE } from '../../lib/site';
import { BIO_STATS, BIO_FACTS, KITCHENS_WORKED_WITH, CHEFS_LEARNED_FROM } from '../../lib/program';

const galleryImages = [
  { src: g1, alt: 'Vendégek telefonnal fotóznak egy közös vacsorán' },
  { src: g2, alt: 'Kardos Bálint a konyhapultnál dolgozik' },
  { src: g3, alt: 'Kültéri vacsora hangulatos fényekkel' },
  { src: g4, alt: 'Kézzel tekert tavaszi tekercsek egy közös főzésen' },
  { src: g5, alt: 'Kardos Bálint a vendégekkel beszélget vacsora közben' },
  { src: g6, alt: 'Polaroidok a közös vacsorák és események pillanataiból' },
];

// Person séma — a márka arca Kardos Bálint személye, ezért ő maga a strukturált adat
// alanya (nem az Organization, aminek a párja a főoldalon szerepel).
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: new URL('/rolam/', SITE.url).toString(),
  image: new URL(heroImage.src, SITE.url).toString(),
  jobTitle: 'Séf és életmód-tanácsadó',
  description: SITE.description,
  sameAs: [SITE.instagram, SITE.facebook],
  worksFor: {
    '@type': 'Organization',
    name: SITE.name,
  },
};
---

<Layout
  title="Rólam — a növényi séf, akinek emberek kellettek"
  description="Kardos Bálint karrierváltásától a séfkedésig: hogyan lett vacsorapartikból közösségépítő misszió."
  image={heroImage.src}
>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} slot="head" is:inline />
  <section class="bg-sage-100 py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2 md:items-center md:px-6">
      <div>
        <p class="font-script text-3xl text-clay-500 mb-2">Szia, Bálint vagyok</p>
        <h1 class="text-4xl md:text-5xl font-semibold text-forest-700 mb-6">
          Növényi séf lettem, mert <span class="font-script text-clay-500">emberekre</span> volt szükségem
        </h1>
        <p class="text-lg text-forest-600">
          2020 óta szervezek vacsorapartikat és gasztroeseményeket. Azóta eljutottam a 12 fős, 5 fogásos
          lakásvacsoráktól egy 30 fős, 7 fogásos jótékonysági gáláig — és rájöttem, hogy a legjobb
          beszélgetéseim mindig az asztal körül történtek.
        </p>
      </div>
      <Image src={heroImage} alt="Kardos Bálint főzés közben, séf-egyenruhában" width={600} height={600} loading="eager" fetchpriority="high" class="w-full rounded-3xl object-cover aspect-square" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {
        BIO_STATS.map((stat) => (
          <div class="rounded-2xl bg-sage-50 p-6 text-center">
            <p class="font-heading text-3xl font-semibold text-clay-500">{stat.value}</p>
            <p class="mt-1 text-sm text-forest-600">{stat.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 border-t border-sage-200 pt-8 text-center">
      <p class="mb-5 text-sm font-semibold uppercase tracking-wide text-forest-500">Ezeken a konyhákon dolgoztam</p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {
          KITCHENS_WORKED_WITH.map((kitchen) => (
            <span class="font-heading text-base font-semibold text-forest-700/70 md:text-lg">
              {kitchen.name} <span class="text-forest-400" aria-hidden="true">—</span>{' '}
              <span class="font-normal text-forest-500">{kitchen.location}</span>
            </span>
          ))
        }
      </div>
      <p class="mt-5 text-sm text-forest-500">+ fesztiválok, elvonulások, esküvők és privát események szerte az országban</p>
    </div>

    <div class="mt-8 border-t border-sage-200 pt-8 text-center">
      <p class="mb-5 text-sm font-semibold uppercase tracking-wide text-forest-500">Séfeim, akiktől a legtöbbet tanultam</p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {
          CHEFS_LEARNED_FROM.map((chef) => (
            <span class="font-heading text-base font-semibold text-forest-700/70 md:text-lg">{chef}</span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <div class="prose-okos">
      <h2>Az elejétől</h2>
      <p>
        Az egész Steiner Kristóf szakácskönyveivel indult — az ő receptjeiből tanultam meg igazán
        főzni, és sokáig jártam a vacsoráira és a workshopjaira is, hogy lássam, hogyan gondolkodik
        valaki, aki nem csak tud főzni, hanem tanítani is szeret. Onnantól nem volt visszaút — de
        egy jó darabig csak hobbi maradt: magamnak és a barátaimnak főztem, munkaként eszembe sem
        jutott.
      </p>
      <p>
        Sosem terveztem, hogy séf leszek — de 2020 óta ez lett belőle. Azóta 6 országban, 65 saját
        szervezésű eseményen, 1200+ vendégnek főztem, és összesen több mint 20 000 tányér ételt adtam ki.
        Volt, hogy 80–100 fős esküvőn vagy elvonuláson álltam a tűzhely mögött, volt, hogy 9 hónapig
        egy budai család privát séfjeként dolgoztam, és vezettem már konyhát az ország egyik
        legnagyobb fesztiválján is.
      </p>
      <ul>
        {BIO_FACTS.map((fact) => <li>{fact}</li>)}
      </ul>
      <h2>A séf-évek</h2>
      <p>
        A jótékonysági vacsoráim onnan indultak, hogy egy régi ismerősöm, Forgács-Fábián Sára hívott:
        az Amigos a Gyerekekért Alapítvány egy Nagykövet kampányához keresett inspiráló embereket.
        Nyolc vacsorát tartottam egy hónap alatt, és 524 000 forintot gyűjtöttünk össze — ezek voltak
        az első öt fogásos vacsoráim is. De a legfontosabb tanulság nem a szám volt: előtte, majdnem
        egy éven át, minden vacsorát a lakótársammal saját zsebből finanszíroztunk, a vendégek számára
        díjmentesen. Ha nincs ez a kampány, valószínűleg a mai napig nem mernék pénzt kérni a
        vacsoráimért.
      </p>
      <p>
        Emellett az elmúlt években chef de partie-ként dolgoztam éttermekben: megfordultam ázsiai,
        közel-keleti, mexikói és francia inspirációjú, interkontinentális konyhákon egyaránt. Dolgoztam
        fine bistróban, egyszerű bisztróban, reggelis-brunch helyen, és egy nagyforgalmú belvárosi
        étteremben is — ott volt olyan nap, amikor több mint ezer adag ételt adtunk ki.
      </p>
      <p>
        Most itt az idő, hogy átadjam, amit megtanultam, és a mindennapok embereinek segítsek
        egészséges, finom ételeket készíteni — a lehető legolcsóbban és leggyorsabban.
      </p>
      <h2>Miért séf, és miért tanácsadó is egyben?</h2>
      <p>
        Mert a főzés önmagában nem elég — az emberek nem attól esznek egészségesebben, hogy egyszer
        kapnak egy remek vacsorát tőlem. Ezért szereztem életmód-tanácsadói (Lifestyle Medicine
        Consultant) végzettséget is: hogy ne csak megfőzzem az ételt, hanem megtanítsam a rendszert, ami
        mögötte van.
      </p>
    </div>

    <figure class="mt-8 rounded-2xl bg-sage-50 p-4">
      <Image
        src={lifestyleMedicineCertificate}
        alt="Lifestyle Medicine Consultant (Életmód-tanácsadó) tanúsítvány, Kardos Bálint nevére kiállítva"
        width={1000}
        height={563}
        class="w-full rounded-xl"
      />
      <figcaption class="mt-3 text-center text-sm text-forest-500">
        Lifestyle Medicine Consultant (Életmód-tanácsadó) tanúsítvány
      </figcaption>
    </figure>

    <div class="prose-okos mt-8">
      <h2>Miért közösség, és miért nem csak recept?</h2>
      <p>
        Mert a recept önmagában nem old meg semmit. Azoknak, akikkel dolgozom, ritkán a tudás hiányzik —
        inkább a tér, az idő és a bátorítás, hogy elkezdjék. Ezért nem csak recepteket adok, hanem
        közösséget: az <a href="/okoskonyha/">Okoskonyhát</a>, ahol együtt haladunk, és a vacsorapartikat,
        ahol testközelből lehet megtapasztalni, milyen az, amikor az étel tényleg összeköt embereket.
      </p>
      <blockquote>
        „Nem az a célom, hogy mindenki vegán legyen. Az a célom, hogy mindenki egy kicsit kevésbé legyen
        egyedül a saját konyhájában — és az életében.”
      </blockquote>
      <h2>Így született meg az Okoskonyha</h2>
      <p>
        A batch cooking rendszerrel 2022-ben kezdtem el igazán foglalkozni, amikor egy budai család
        privát séfjeként dolgoztam. Heti kétszer jártam ki hozzájuk, és úgy főztem nekik, hogy
        abból egész hétre elegendő étel legyen — nem napi egy-egy fogást készítettem, hanem egy
        rendszert, ami napokon át tartja a formáját és az ízét. Itt kezdett el kirajzolódni az a
        logika, amit ma az Okoskonyhában tanítok.
      </p>
      <p>
        Ezt a rendszert akkor emeltem új szintre, amikor ezzel egyidőben elkezdtem magamnak is
        otthon ugyanígy főzni: batchekben elkészíteni és eltárolni az alapokat, hogy a saját heteim
        is ugyanolyan könnyűek legyenek, mint amilyenné a családnak tettem őket. Ami náluk munkaként
        indult, otthon vált igazán személyes tapasztalattá — és innen már csak egy lépés volt, hogy
        közösséggé formáljam, amit ma az Okoskonyhában adok tovább.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 md:px-6">
    <SectionHeading eyebrow="Egy meghatározó élmény" title="A milánói" accent="kaland" />
    <div class="prose-okos">
      <p>
        Az egyik legmeghatározóbb élményem egy milánói vacsora, amit kizárólag egymást nem ismerő,
        teljesen idegen embereknek szerveztem — öt fogás, teljesen növényi menü. Volt, aki egyedül
        érkezett, volt, aki bizonytalan volt, hogy egyáltalán jó ötlet-e eljönni, és az invitálás során
        visszautasításokat is kaptam. A nap végére mégis úgy búcsúztunk egymástól, mintha régi barátok
        lennénk: nevettünk, megnyíltunk egymásnak, órákon át beszélgettünk, és senki nem akart hazamenni.
      </p>
    </div>

    <div class="my-8">
      <YouTubeEmbed videoId="yYsfMgttTxo" title="A milánói kaland" caption="A milánói kaland — a teljes videó" />
    </div>

    <div class="prose-okos">
      <p>
        A történet azóta sem ért véget. A résztvevők azóta is tartják a kapcsolatot, találkoztak újra,
        barátságok születtek belőle. Az egyik tetoválásom is ebből az estéből született — és nem csak
        rajtam van: rajtam kívül még <strong>hat másik ember</strong> viseli ugyanazt, mert úgy
        döntöttünk, hogy ezt az estét egész életünkben magunkkal akarjuk hordozni.
      </p>
      <p>
        Az éttermi konyhák pörgése, a jótékonysági vacsorák, Milánó — mind ugyanarra a felismerésre
        vezettek: a legjobb pillanatok ott történnek, ahol van egy jó tál étel, elég idő, és emberek,
        akik hajlandók leülni egymás mellé. Ezt viszem tovább az Okoskonyhába is — csak épp nem egyetlen
        estére, hanem hétről hétre.
      </p>
    </div>
  </section>

  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="Pillanatok" title="Az asztal körül" accent="történt" />
      <Gallery images={galleryImages} />
    </div>
  </section>

  <InstagramFeed />

  <section class="mx-auto max-w-4xl px-4 py-16 text-center md:px-6">
    <h2 class="text-3xl font-semibold text-forest-700 mb-4">Gyere, ismerkedjünk meg élőben is</h2>
    <p class="text-forest-600 mb-8">
      Akár egy privát vacsorát szeretnél, akár csak beszélgetnél velem az életmódváltásról, szívesen
      találkozom veled.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <CTAButton href="/kapcsolat/" label="Írj üzenetet" size="lg" />
      <CTAButton href={SITE.circleUrl} label="Nézd meg az Okoskonyhát" variant="ghost" size="lg" outbound />
    </div>
  </section>
</Layout>
