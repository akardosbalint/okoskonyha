---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import BlogSearch from '../../../components/BlogSearch.astro';
import { BLOG_CATEGORIES } from '../../../lib/site';

export async function getStaticPaths() {
  return Object.keys(BLOG_CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const categoryInfo = BLOG_CATEGORIES[category as keyof typeof BLOG_CATEGORIES];
const posts = (await getCollection('blog', (post) => post.data.category === category)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title={`${categoryInfo.label} — Blog`} description={categoryInfo.description}>
  <section class="bg-sage-100 py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center md:px-6">
      <p class="font-script text-3xl text-clay-500 mb-1">Kategória</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-forest-700 mb-4">{categoryInfo.label}</h1>
      <p class="text-lg text-forest-600">{categoryInfo.description}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <BlogSearch />

    <div class="mb-10 flex flex-wrap gap-3">
      <a href="/blog/" class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-forest-700 border border-sage-200 hover:bg-sage-100">
        Összes bejegyzés
      </a>
      {
        Object.entries(BLOG_CATEGORIES).map(([slug, cat]) => (
          <a
            href={`/blog/kategoria/${slug}/`}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-semibold',
              slug === category ? 'bg-forest-700 text-cream' : 'bg-white text-forest-700 border border-sage-200 hover:bg-sage-100',
            ]}
          >
            {cat.label}
          </a>
        ))
      }
    </div>

    {
      posts.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => <BlogCard post={post} featured={i === 0} />)}
        </div>
      ) : (
        <p class="text-forest-500">Hamarosan érkeznek ide az első bejegyzések.</p>
      )
    }
  </section>
</Layout>
