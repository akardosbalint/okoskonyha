---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import Icon from '../../components/Icon.astro';
import MembershipPricing from '../../components/MembershipPricing.astro';
import AdvancedTopicsTeaser from '../../components/AdvancedTopicsTeaser.astro';
import FlexibleDietCallout from '../../components/FlexibleDietCallout.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import balintProfile from '../../assets/photos/balint-cooking-portrait.jpeg';
import { SITE } from '../../lib/site';
import { METHOD_PILLARS, MEMBERSHIP_BENEFITS, PRICING } from '../../lib/program';

const testimonialEntries = await getCollection('testimonials');
const methodIcons = ['book', 'shield', 'coin', 'salt', 'fat', 'acid', 'heat', 'leaf', 'plate', 'calendar', 'basket', 'clock'] as const;

const painPoints = [
  'Minden nap azon gondolkodsz, mi legyen vacsira — és este 7-kor még mindig nincs válasz.',
  'Vagy sokat költesz éttermi kajára, vagy olyan alapanyagot veszel, ami nem is jó igazán.',
  'Ha főzöl is, órákig tart, és a hét közepére már nincs kedved hozzá.',
  'Tudod, hogy egészségesebben kéne enned, de nem tudod, hol kezdd el — receptek helyett rendszer kellene.',
];

const outcomes = [
  'Heti max. 2 főzéssel egész hétre megvan a jó kaja — nincs több esti kapkodás.',
  'Megtanulod, hol és hogyan vásárolj úgy, hogy jobb alapanyag kerüljön az asztalodra, kevesebb pénzért.',
  'A batch cooking rendszerrel pár óra főzés = egy egész hét étkezése, káoszmentesen.',
  'A só-zsír-sav-hő és a tányér-elv után receptek nélkül is tudsz finomat és táplálót összerakni.',
];

const faqs = [
  { q: 'Mennyibe kerül a tagság?', a: 'A pontos árat és elszámolási időszakot lásd fentebb az árazásnál — nincs rejtett költség, és bármikor lemondható.' },
  { q: 'Bármikor lemondhatom a tagságot?', a: 'Igen, a tagság a mindenkori elszámolási ciklus végén megújul, és bármikor lemondhatod a Circle.so felületén, indoklás nélkül.' },
  { q: 'Van próbaidőszak?', a: 'Igen, mindkét csomaghoz jár 3 napos ingyenes próbaidőszak (ehhez bankkártya megadása szükséges) — a próbaidő alatt bármikor, indoklás nélkül lemondhatod, és nem kerül levonásra semmi.' },
  { q: 'Havonta kerül levonásra a tagdíj?', a: 'A „Havi tagság” a próbaidőszak után minden naptári hónapban egyszer újul meg és kerül terhelésre. Az „Éves tagság” évente egyszer.' },
  { q: 'Kezdőként is érdemes csatlakoznom?', a: 'Igen — a legtöbb tagunk kezdőként érkezik. A recepteket és az élő alkalmakat is úgy építjük fel, hogy bármilyen szinten el lehessen indulni.' },
  { q: 'Kell hozzá speciális konyhai felszerelés?', a: 'Nem. A recepteket úgy tervezem, hogy egy alap felszereléssel (fazék, serpenyő, éles kés) is elkészíthetők legyenek.' },
  { q: 'Mi az a Circle.so, és miért oda visztek át?', a: 'A Circle.so egy dedikált közösségi platform, ahol a tagság kezelése, a fizetés és a zárt tartalmak biztonságosan és kényelmesen működnek.' },
  { q: 'Csak növényi (vegán) receptek vannak?', a: 'Alapvetően igen, de van egy fontos árnyalat: nem is „vegán”, hanem teljes értékű, növényi alapú táplálkozásról (whole-food plant-based diet) van szó — a Lifestyle Medicine (életmód-orvoslás) keretrendszerére építek, mert ezt tartom a legegészségesebbnek, és emiatt ez az alapja mindennek, amit az Okoskonyhában tanítok. Ugyanakkor a közösségben nem elsősorban recepteket tanulsz — bár azok is vannak, hogy legyen miből elindulnod —, hanem koncepciókat és technikákat, amiket ugyanúgy tudsz alkalmazni akkor is, ha vegyesen étkezel.' },
  { q: 'Mennyi időt kell rá szánnom hetente?', a: 'A rendszer alapja a heti 2×2 óra: egy nagyobb batch cooking főzés hétvégén, plusz egy rövidebb kombinálós alkalom a hét közepén — a többi nap csak összerakod, amit előre elkészítettél.' },
  { q: 'Mi van, ha nincs időm minden héten főzni?', a: 'Semmi gond — a tananyag és a receptek bármikor elérhetők, saját tempódban haladhatsz, és egy kihagyott hét után egyszerűen folytatod, ahol abbahagytad.' },
  { q: 'Mi történik, ha elakadok egy recepttel vagy technikával?', a: 'A zárt közösségben bármikor kérdezhetsz — tőlem és a tagtársaidtól is —, és a havi élő főzős alkalmon is hozhatod a konkrét problémáidat.' },
  { q: 'Mikor nyílnak meg a haladó mesterkurzusok?', a: 'Az Alapképzés (a Batch Cooking Alapkurzus) elvégzése után — ez adja meg azt a biztos alaptudást, amire a haladó témák (fermentálás, kovászolás, mesterkurzusok) épülnek.' },
];

const toAmount = (price: string) => price.replace(/[^0-9]/g, '');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: PRICING.programName,
  description: 'Zárt online közösség heti receptekkel, havi élő főzős alkalmakkal és a batch cooking módszerrel — heti max. 2×2 óra főzéssel a heti főétkezések megoldva.',
  provider: {
    '@type': 'Person',
    name: SITE.name,
  },
  areaServed: 'HU',
  offers: [
    {
      '@type': 'Offer',
      name: PRICING.monthly.label,
      price: toAmount(PRICING.monthly.price),
      priceCurrency: 'HUF',
      priceValidUntil: '2026-07-31',
      url: SITE.checkoutUrl,
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: PRICING.annual.label,
      price: toAmount(PRICING.annual.price),
      priceCurrency: 'HUF',
      priceValidUntil: '2026-07-31',
      url: SITE.checkoutUrl,
      availability: 'https://schema.org/InStock',
    },
  ],
};

// A hero-kép a Largest Contentful Paint eleme ezen az oldalon. loading="eager" + fetchpriority="high"
// csak azután segít, hogy a böngésző HTML-elemzése elért eddig a pontig — egy <link rel="preload">
// a <head>-ben korábban, a dokumentum elemzésének elején felfedezteti a képet, mielőtt a
// letöltéséhez egyáltalán elérne ide a parser. A getImage()-nek pontosan ugyanazokat a
// paramétereket kell kapnia, mint a lenti <Image>-nek, hogy ugyanarra a build-generált URL-re mutasson.
const heroImagePreload = await getImage({ src: balintProfile, width: 600, height: 600 });
---

<Layout
  title="Okoskonyha — heti 2×2 óra, kész főétkezések"
  description="Csatlakozz az Okoskonyha közösséghez: heti receptek, havi élő főzős alkalmak és egy csapat, aki melletted áll a gyorsabb, olcsóbb főzésben."
  hideMobileCta
>
  <link rel="preload" as="image" href={heroImagePreload.src} fetchpriority="high" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} slot="head" is:inline />
  <!-- Hero -->
  <section class="bg-sage-300 py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2 md:items-center md:px-6">
      <div>
        <p class="font-script text-3xl text-forest-700 mb-3">Kardos Bálint Okoskonyhája</p>
        <div class="mb-4 flex flex-wrap gap-2">
          <span class="rounded-full bg-forest-700 px-4 py-1.5 text-sm font-semibold text-cream">Zárt online közösség</span>
          <span class="rounded-full bg-clay-600 px-4 py-1.5 text-sm font-semibold text-cream">Növényi alapú főzés</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-forest-800 leading-tight mb-6">
          Főzz <span class="font-script text-clay-600">finomabbat</span> és egészségesebbet — olcsóbban és gyorsabban
        </h1>
        <p class="text-lg text-forest-800/90 mb-8 max-w-xl">
          Az Okoskonyha egy zárt online közösség azoknak, akik szeretnének olcsóbban, gyorsabban és
          egészségesebben főzni — teljes értékű, növényi alapon (whole-food plant-based diet). Heti
          receptek, élő alkalmak és egy csapat, aki melletted áll.
        </p>
        <div class="flex flex-wrap gap-4">
          <CTAButton href={SITE.checkoutUrl} label="Csatlakozom most" size="lg" outbound trackingId="join_cta" />
          <CTAButton href="/kapcsolat/" label="Van egy kérdésem előtte" variant="ghost" size="lg" />
        </div>
        <p class="mt-4 text-sm text-forest-700">Bármikor lemondható. Nincs hosszú távú elköteleződés.</p>
      </div>
      <Image src={balintProfile} alt="Kardos Bálint főzés közben, kötényben" width={600} height={600} loading="eager" fetchpriority="high" class="w-full rounded-3xl object-cover aspect-square" />
    </div>
  </section>

  <!-- Pain / agitation -->
  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="Ismerős?" title="Ami most" accent="nem működik" />
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-3xl bg-white p-6 md:p-8 shadow-sm shadow-forest-900/5">
          <h3 class="font-heading text-xl font-semibold text-forest-500 mb-4">Most valószínűleg ez megy</h3>
          <ul class="space-y-4">
            {
              painPoints.map((point) => (
                <li class="flex gap-3 text-forest-700">
                  <span class="mt-1 text-clay-600" aria-hidden="true">✕</span>
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-3xl bg-forest-700 p-6 md:p-8 text-cream">
          <h3 class="font-heading text-xl font-semibold mb-4 text-cream">Ez lesz helyette</h3>
          <ul class="space-y-4">
            {
              outcomes.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-1 text-sage-200" aria-hidden="true">✓</span>
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="A módszer" title="Amit a közösségben" accent="megtanulsz" />
    <p class="mx-auto -mt-6 mb-10 max-w-2xl text-center text-forest-600">
      Ez nem csak időt spórol — <strong class="font-semibold text-forest-800">pénzügyileg is jobban
      jársz, mint most</strong>. Amint a heti bevásárlás és a batch cooking rutinná válik, kevesebb
      megy el kapkodva vásárolt alapanyagra és kiszállításra — ugyanannyiért jobban is eszel.
    </p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        METHOD_PILLARS.map((pillar, i) => (
          <div class="rounded-3xl bg-white p-6 md:p-8 shadow-md shadow-forest-900/5">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-sage-100 text-forest-700">
              <Icon name={methodIcons[i]} class="h-7 w-7" />
            </div>
            <h3 class="font-heading text-xl font-semibold text-forest-800">{pillar.title}</h3>
            <p class="mt-1 text-sm font-semibold text-clay-600">{pillar.subtitle}</p>
            <p class="mt-3 text-forest-600">{pillar.text}</p>
          </div>
        ))
      }
    </div>
    <AdvancedTopicsTeaser />
    <FlexibleDietCallout />
  </section>

  <!-- Mit kapsz -->
  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="Mit kapsz" title="A tagság" accent="tartalma" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          MEMBERSHIP_BENEFITS.map((b) => (
            <div class="rounded-2xl bg-white p-6 shadow-sm shadow-forest-900/5">
              <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-sage-100 text-forest-700">
                <Icon name={b.icon} class="h-6 w-6" />
              </div>
              <h3 class="font-heading font-semibold text-forest-800 mb-1">{b.title}</h3>
              <p class="text-sm text-forest-600">{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <HowItWorks />

  <TestimonialCarousel
    items={testimonialEntries.map((t) => ({ name: t.data.name, role: t.data.role, quote: t.data.quote, avatar: t.data.avatar }))}
    eyebrow="Mielőtt döntenél"
    title="Kóstolj bele a"
    accent="stílusomba"
    note="Ezek a visszajelzések jótékonysági vacsoráim és privát főzéseim vendégeitől származnak — nem az Okoskonyha tagságról szólnak, hanem arról a főzési stílusról és hozzáállásról, amire a módszertan épül. Ahogy a közösség bővül, itt osztjuk majd meg az első tagi visszajelzéseket is."
  />

  <!-- Pricing -->
  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="Árazás" title="Válaszd ki, mi illik" accent="hozzád" />
    <MembershipPricing />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="GYIK" title="Gyakori" accent="kérdések" />
    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details class="group rounded-2xl bg-sage-50 p-5 open:bg-white open:shadow-md">
            <summary class="cursor-pointer list-none font-heading font-semibold text-forest-800 flex items-center justify-between">
              {faq.q}
              <span class="ml-4 text-clay-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-forest-600">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Final CTA -->
  <section class="mx-auto max-w-4xl px-4 py-16 md:py-20 text-center md:px-6">
    <div class="rounded-3xl bg-clay-600 px-6 py-14 md:px-16">
      <h2 class="text-3xl md:text-4xl font-semibold text-cream mb-4">Készen állsz a csatlakozásra?</h2>
      <p class="text-cream/90 mb-8">Lépj be az Okoskonyhába, és kezdj el ma egyszerűbben, olcsóbban és egészségesebben főzni.</p>
      <CTAButton href={SITE.checkoutUrl} label="Csatlakozom az Okoskonyhához" variant="ghost" size="lg" outbound trackingId="join_cta" />
    </div>
  </section>
</Layout>
