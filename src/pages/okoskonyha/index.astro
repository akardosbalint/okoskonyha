---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import Icon from '../../components/Icon.astro';
import ValueStackTable from '../../components/ValueStackTable.astro';
import PriceAnchor from '../../components/PriceAnchor.astro';
import GuaranteeBox from '../../components/GuaranteeBox.astro';
import okoskonyhaHero from '../../assets/illustrations/okoskonyha-hero.svg';
import { SITE } from '../../lib/site';
import {
  BIO_STATS,
  METHOD_PILLARS,
  CURRICULUM,
  BONUSES,
  PRICING,
  SCARCITY,
  DISCOVERY_CALL_QUESTIONS,
} from '../../lib/program';

const testimonialEntries = await getCollection('testimonials');

const methodIcons = ['salt', 'plate', 'clock', 'basket'] as const;

const painPoints = [
  'Minden nap azon gondolkodsz, mi legyen vacsira — és este 7-kor még mindig nincs válasz.',
  'Vagy sokat költesz éttermi kajára, vagy olyan alapanyagot veszel, ami nem is jó igazán.',
  'Ha főzöl is, órákig tart, és a hét közepére már nincs kedved hozzá.',
  'Tudod, hogy egészségesebben kéne enned, de nem tudod, hol kezdd el — receptek helyett rendszer kellene.',
];

const outcomes = [
  'Heti max. 2 főzéssel egész hétre megvan a jó kaja — nincs több esti kapkodás.',
  'Megtanulod, hol és hogyan vásárolj úgy, hogy jobb alapanyag kerüljön az asztalodra, kevesebb pénzért.',
  'A batch cooking rendszerrel 6–8 óra főzés = egy egész hét étkezése, káoszmentesen.',
  'A só-zsír-sav-hő és a tányér-elv után receptek nélkül is tudsz finomat és táplálót összerakni.',
];

const faqs = [
  { q: 'Mi a különbség az Alapprogram és a VIP program között?', a: 'Az Alapprogram a teljes rendszert megtanítja neked 8 hét alatt, csoportos kérdezz-felelekkel és privát konzultációkkal. Ha még szorosabb, személyre szabottabb támogatásra vágysz, a discovery hívás alatt megbeszéljük, hogy a VIP program illik-e jobban hozzád.' },
  { q: 'Mi van, ha nem nekem való?', a: 'Ezért van a 8 hetes pénzvisszafizetési garancia: ha a program végén sem érzed, hogy javult az étkezésed, visszakapod a teljes részvételi díjat.' },
  { q: 'Mennyi időt kell rá szánnom hetente?', a: 'A cél pontosan az, hogy minél kevesebb legyen: heti 1-2 főzési alkalom (összesen 6-8 óra) elég a teljes heti étkezésedhez, plusz a heti 60 perces élő alkalom, ha részt tudsz venni rajta (felvételről is visszanézhető).' },
  { q: 'Kezdőként is érdemes csatlakoznom?', a: 'Igen — a legtöbb tagunk kezdőként érkezik. A rendszert úgy építettem fel, hogy nulláról is követhető legyen, még ha eddig alig főztél is.' },
  { q: 'Miért csak 15 fő egy körben?', a: 'Mert a privát konzultációk és az élő kérdezz-felelek csak így maradnak valóban személyesek. Amint betelik a keret, az első kör zárul, és a következő körre kerülsz a várólistára.' },
];
---

<Layout
  title="Okoskonyhája Alapprogram — főzz finomabbat és egészségesebbet, olcsóbban és gyorsabban"
  description="8 hét alatt garantáltan megtanulsz olcsóbban, gyorsabban, finomabbat és egészségesebbet főzni — heti max. 2 főzéssel, káoszmentesen. Max. 15 fő, pénzvisszafizetési garanciával."
>
  <!-- Hero -->
  <section class="bg-sage-300 py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2 md:items-center md:px-6">
      <div>
        <p class="font-script text-3xl text-forest-700 mb-2">Kardos Bálint Okoskonyhája</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-forest-800 leading-tight mb-6">
          Főzz <span class="font-script text-clay-600">finomabbat</span> és egészségesebbet — olcsóbban és gyorsabban
        </h1>
        <p class="text-lg text-forest-800/90 mb-8 max-w-xl">
          Az Okoskonyhája Alapprogrammal 8 hét alatt garantáltan megtanulod, hogyan oldd meg heti max. 2
          főzéssel az egész heti étkezésedet — káoszmentesen, kajapánik nélkül.
        </p>
        <div class="flex flex-wrap gap-4">
          <CTAButton href="/kapcsolat/" label="Foglalj ingyenes beszélgetést" size="lg" />
          <CTAButton href={SITE.circleUrl} label="Már döntöttél? Csatlakozom" variant="ghost" size="lg" outbound />
        </div>
        <p class="mt-4 text-sm text-forest-700/80">
          Nincs kockázat: pénzvisszafizetési garancia · max. {PRICING.cohortCap} fő / kör
        </p>
      </div>
      <Image src={okoskonyhaHero} alt="Illusztráció egy fazékról" width={600} height={400} class="w-full rounded-3xl" />
    </div>
  </section>

  <!-- Credibility strip -->
  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        BIO_STATS.map((stat) => (
          <div class="rounded-2xl bg-sage-50 p-6 text-center">
            <p class="font-heading text-3xl font-semibold text-clay-500">{stat.value}</p>
            <p class="mt-1 text-sm text-forest-600">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Pain / agitation -->
  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="Ismerős?" title="Ami most" accent="nem működik" />
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-3xl bg-white p-6 md:p-8 shadow-sm shadow-forest-900/5">
          <h3 class="font-heading text-xl font-semibold text-forest-500 mb-4">Most valószínűleg ez megy</h3>
          <ul class="space-y-4">
            {
              painPoints.map((point) => (
                <li class="flex gap-3 text-forest-700">
                  <span class="mt-1 text-clay-500" aria-hidden="true">✕</span>
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-3xl bg-forest-700 p-6 md:p-8 text-cream">
          <h3 class="font-heading text-xl font-semibold mb-4">8 hét múlva ez lesz helyette</h3>
          <ul class="space-y-4">
            {
              outcomes.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-1 text-sage-200" aria-hidden="true">✓</span>
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="A módszer" title="Amit az Alapprogramban" accent="megtanulsz" />
    <div class="grid gap-6 sm:grid-cols-2">
      {
        METHOD_PILLARS.map((pillar, i) => (
          <div class="rounded-3xl bg-white p-6 md:p-8 shadow-md shadow-forest-900/5">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-sage-100 text-forest-700">
              <Icon name={methodIcons[i]} class="h-7 w-7" />
            </div>
            <h3 class="font-heading text-xl font-semibold text-forest-800">{pillar.title}</h3>
            <p class="mt-1 text-sm font-semibold text-clay-500">{pillar.subtitle}</p>
            <p class="mt-3 text-forest-600">{pillar.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Curriculum / mit kapsz -->
  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="Mit kapsz" title="A program" accent="tartalma" />
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-3xl bg-white p-6 md:p-8 shadow-sm shadow-forest-900/5">
          <h3 class="font-heading text-lg font-semibold text-forest-800 mb-4">{PRICING.programName} — {PRICING.durationLabel}</h3>
          <ul class="space-y-3">
            {
              CURRICULUM.map((item) => (
                <li class="flex gap-3 text-forest-700">
                  <span class="mt-1 text-clay-500" aria-hidden="true">✓</span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-3xl bg-white p-6 md:p-8 shadow-sm shadow-forest-900/5">
          <h3 class="font-heading text-lg font-semibold text-forest-800 mb-4">+ Ajándékok</h3>
          <ul class="space-y-3">
            {
              BONUSES.map((item) => (
                <li class="flex gap-3 text-forest-700">
                  <span class="mt-1 text-clay-500" aria-hidden="true">🎁</span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="Árazás" title="Mennyibe kerül" accent="mindez?" />
    <PriceAnchor />
    <p class="mx-auto mt-4 max-w-xl text-center text-sm text-forest-500">{PRICING.priceNote}</p>
    <div class="mt-10">
      <ValueStackTable />
    </div>
    <div class="mt-8 flex justify-center">
      <CTAButton href="/kapcsolat/" label="Foglalj ingyenes beszélgetést" size="lg" />
    </div>
  </section>

  <!-- Guarantee + scarcity -->
  <section class="mx-auto max-w-4xl px-4 pb-16 md:px-6 space-y-6">
    <GuaranteeBox />
    <div class="rounded-3xl bg-white p-6 md:p-8 shadow-sm shadow-forest-900/5">
      <h3 class="font-heading text-xl font-semibold text-forest-800 mb-3">{SCARCITY.title}</h3>
      <ul class="space-y-2">
        {
          SCARCITY.points.map((point) => (
            <li class="flex gap-3 text-forest-700">
              <span class="mt-1 text-clay-500" aria-hidden="true">•</span>
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <TestimonialCarousel
    items={testimonialEntries.map((t) => ({ name: t.data.name, role: t.data.role, quote: t.data.quote, avatar: t.data.avatar }))}
    eyebrow="Tagok mondták"
    title="Amit a közösségről"
    accent="mondanak"
  />

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="GYIK" title="Gyakori" accent="kérdések" />
    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details class="group rounded-2xl bg-sage-50 p-5 open:bg-white open:shadow-md">
            <summary class="cursor-pointer list-none font-heading font-semibold text-forest-800 flex items-center justify-between">
              {faq.q}
              <span class="ml-4 text-clay-500 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-forest-600">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Final CTA -->
  <section class="mx-auto max-w-4xl px-4 pb-20 text-center md:px-6">
    <div class="rounded-3xl bg-clay-500 px-6 py-14 md:px-16">
      <h2 class="text-3xl md:text-4xl font-semibold text-cream mb-4">Beszéljünk 20 percet</h2>
      <p class="mx-auto mb-6 max-w-xl text-cream/90">Semmi nyomulás, csak tisztán átnézzük:</p>
      <ul class="mx-auto mb-8 max-w-md space-y-2 text-left text-cream/90">
        {
          DISCOVERY_CALL_QUESTIONS.map((q) => (
            <li class="flex gap-3">
              <span aria-hidden="true">→</span> {q}
            </li>
          ))
        }
      </ul>
      <CTAButton href="/kapcsolat/" label="Foglalj ingyenes beszélgetést" variant="ghost" size="lg" />
      <p class="mt-6 text-sm text-cream/70">
        Már készen állsz csatlakozni?
        <a href={SITE.circleUrl} data-outbound="okoskonyha" data-cta-label="okoskonyha_final_direct" class="underline hover:text-cream">
          Nézd meg a közösséget a Circle.so-n
        </a>
      </p>
    </div>
  </section>
</Layout>
