---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import contactHero from '../../assets/illustrations/contact-hero.svg';
import { SITE } from '../../lib/site';
---

<Layout
  title="Kapcsolat"
  description="Vedd fel velem a kapcsolatot privát séfkedés, jótékonysági vacsora vagy egy gyors kérdés miatt az Okoskonyhával kapcsolatban."
>
  <section class="bg-sage-100 py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2 md:items-center md:px-6">
      <div>
        <p class="font-script text-3xl text-clay-500 mb-2">Beszéljünk</p>
        <h1 class="text-4xl md:text-5xl font-semibold text-forest-700 mb-6">Kapcsolat</h1>
        <p class="text-lg text-forest-600">
          Írj pár sort, mit szeretnél — privát vacsorát, jótékonysági estet, vagy csak egy gyors kérdésed
          van az Okoskonyhával kapcsolatban. Vagy foglalj egyből egy időpontot alább.
        </p>
      </div>
      <Image src={contactHero} alt="Illusztráció egy naptárról" width={600} height={400} class="w-full rounded-3xl" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="rounded-3xl bg-white p-6 shadow-md shadow-forest-900/5 md:p-8">
        <h2 class="text-2xl font-semibold text-forest-700 mb-6">Írj üzenetet</h2>
        <ContactForm />
      </div>

      <div class="rounded-3xl bg-white p-6 shadow-md shadow-forest-900/5 md:p-8">
        <h2 class="text-2xl font-semibold text-forest-700 mb-2">Foglalj időpontot</h2>
        <p class="text-forest-600 mb-6">
          Egy 20 perces, ingyenes ismerkedő hívás mindig segít eldönteni, hogyan tudunk együtt dolgozni.
        </p>

        <div data-calendly-wrap class="hidden overflow-hidden rounded-2xl border border-sage-200">
          <div
            class="calendly-inline-widget"
            data-url={SITE.calendlyUrl}
            style="min-width:280px;height:630px;"
          >
          </div>
        </div>

        <div data-calendly-placeholder class="rounded-2xl border border-sage-200 bg-sage-50 p-6 text-center">
          <p class="text-forest-700 mb-4">
            A naptár egy harmadik féltől (Calendly) származó beágyazás, ehhez el kell fogadnod a
            harmadik féltől származó sütiket.
          </p>
          <button
            type="button"
            data-open-cookie-settings-inline
            class="rounded-full bg-clay-500 px-5 py-2.5 text-sm font-heading font-semibold text-cream hover:bg-clay-600"
          >
            Süti beállítások megnyitása
          </button>
        </div>

        <p class="mt-3 text-sm text-forest-500">
          Vagy
          <a href={SITE.calendlyUrl} target="_blank" rel="noopener noreferrer" class="text-clay-500 underline">
            nyisd meg a naptárat közvetlenül, új lapon
          </a>
          — ez nem igényel hozzájárulást.
        </p>

        <div class="mt-8 space-y-2 border-t border-sage-100 pt-6 text-forest-700">
          <p class="font-semibold">Vagy írj közvetlenül:</p>
          <p><a href={`mailto:${SITE.email}`} class="text-clay-500 hover:underline">{SITE.email}</a></p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { hasConsent, CONSENT_CHANGE_EVENT, OPEN_SETTINGS_EVENT } from '../../lib/cookieConsent';

    function loadCalendlyScript() {
      if (document.querySelector('script[data-calendly-widget]')) return;
      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      script.dataset.calendlyWidget = 'true';
      document.body.appendChild(script);
    }

    function updateCalendlyVisibility() {
      const wrap = document.querySelector<HTMLElement>('[data-calendly-wrap]');
      const placeholder = document.querySelector<HTMLElement>('[data-calendly-placeholder]');
      if (hasConsent('marketing')) {
        wrap?.classList.remove('hidden');
        placeholder?.classList.add('hidden');
        loadCalendlyScript();
      } else {
        wrap?.classList.add('hidden');
        placeholder?.classList.remove('hidden');
      }
    }

    updateCalendlyVisibility();
    document.addEventListener(CONSENT_CHANGE_EVENT, updateCalendlyVisibility);

    document.querySelector('[data-open-cookie-settings-inline]')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent(OPEN_SETTINGS_EVENT));
    });
  </script>
</Layout>
