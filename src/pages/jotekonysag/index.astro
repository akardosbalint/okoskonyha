---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatsRow from '../../components/StatsRow.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import Gallery from '../../components/Gallery.astro';
import BlogCard from '../../components/BlogCard.astro';
import g1 from '../../assets/photos/charity-dinner-menu.jpeg';
import g2 from '../../assets/photos/balint-hosting-guests.jpeg';
import g3 from '../../assets/photos/dinner-long-table.jpeg';
import galaVideoPoster from '../../assets/photos/gala-video-poster.jpeg';
import { CHARITY_PARTNERS, CHARITY_STATS } from '../../lib/program';

const testimonialEntries = await getCollection('testimonials');
const jotekonysagPosts = (await getCollection('blog', (p) => p.data.category === 'jotekonysag')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const galleryImages = [
  { src: g1, alt: 'Kézzel írt menükártya egy jótékonysági pop-up vacsorán' },
  { src: g2, alt: 'Kardos Bálint köszönti a vendégeket egy jótékonysági vacsorán' },
  { src: g3, alt: 'Tizenkét vendég egy hosszú asztalnál egy lakásvacsorán' },
];
---

<Layout
  title="Jótékonyság — Minden vacsora valódi hatást is teremt"
  description="Kardos Bálint jótékonysági vacsoráinak eddigi eredményei, partnerszervezetei és a mögöttük álló történetek."
>
  <section class="bg-sage-100 py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2 md:items-center md:px-6">
      <div>
        <p class="font-script text-3xl text-clay-500 mb-2">Amiért igazán csinálom</p>
        <h1 class="text-4xl md:text-5xl font-semibold text-forest-700 mb-6">
          Minden vacsora <span class="font-script text-clay-500">valódi hatást</span> is teremt
        </h1>
        <p class="text-lg text-forest-600">
          A jótékonysági vacsoráim nem gálaestek — nincs frakk, nincs árverési kalapács. Van viszont egy jó
          tál étel, egy őszinte beszélgetés, és minden alkalommal egy konkrét ügy, amit együtt támogatunk.
        </p>
      </div>
      <div class="overflow-hidden rounded-3xl shadow-lg shadow-forest-900/10">
        <video
          class="aspect-square w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster={galaVideoPoster.src}
        >
          <source src="/videos/jotekonysagi-est-highlight.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <StatsRow stats={CHARITY_STATS} />
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 md:px-6">
    <SectionHeading eyebrow="Az első lépés" title="Hogyan kezdődött" accent="minden?" />
    <div class="prose-okos">
      <p>
        2021 őszén csörgött a telefonom: Forgács-Fábián Sára, az Amigos a Gyerekekért Alapítvány
        megálmodója és kuratóriumi elnöke keresett. Elmondta, hogy októberre egy Nagykövet kampányt
        szerveznek, amelyben inspiráló, hasonló értékrenddel rendelkező emberek segítségével a
        szokásosnál nagyobb összegű támogatásokat gyűjtenek az alapítványnak. Amint meghallottam,
        egyértelmű volt: nekem jótékonysági vacsorákat kell tartanom.
      </p>
      <p>
        Tartottam is — nyolcat, heti kettőt, egy hónap alatt. Több mint 65 résztvevővel összesen
        524 000 forintot gyűjtöttünk össze, amivel a kampány második legeredményesebb nagykövete
        lettem. Ezek voltak az első öt fogásos vacsoráim is — onnantól számítom a jótékonysági
        vacsoráim igazi kezdetét.
      </p>
    </div>
  </section>

  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="Kikkel dolgozom" title="Partnerszervezeteink" />
      <div class="grid gap-6 md:grid-cols-3">
        {
          CHARITY_PARTNERS.map((partner) => (
            <div class="rounded-2xl bg-white p-6 shadow-sm shadow-forest-900/5">
              <h3 class="font-heading font-semibold text-forest-800 mb-1">{partner.name}</h3>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-clay-500">{partner.period}</p>
              <p class="text-sm text-forest-600 mb-3">{partner.description}</p>
              <p class="text-sm text-forest-500 border-t border-sage-100 pt-3">{partner.mission}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="Pillanatok" title="A jótékonysági" accent="estékről" />
    <Gallery images={galleryImages} />
  </section>

  <TestimonialCarousel
    items={testimonialEntries.map((t) => ({ name: t.data.name, role: t.data.role, quote: t.data.quote, avatar: t.data.avatar }))}
  />

  {
    jotekonysagPosts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
        <SectionHeading eyebrow="Történetek" title="Sztorik a" accent="vacsorákról" align="left" />
        <div class="grid gap-6 md:grid-cols-3">
          {jotekonysagPosts.map((post) => <BlogCard post={post} />)}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-4xl px-4 pb-20 text-center md:px-6">
    <h2 class="text-3xl font-semibold text-forest-700 mb-4">Legyél te is a következő este része</h2>
    <p class="text-forest-600 mb-8">
      Akár vendégként ülnél le az asztalhoz, akár partnerszervezetként dolgoznátok velünk együtt — szívesen
      beszélgetek róla.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <CTAButton href="/szolgaltatasok/jotekonysagi-vacsorak/" label="Jótékonysági vacsorák" size="lg" />
      <CTAButton href="/kapcsolat/" label="Vegyük fel a kapcsolatot" variant="ghost" size="lg" />
    </div>
  </section>
</Layout>
