---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BlogCard from '../components/BlogCard.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import Icon from '../components/Icon.astro';
import MembershipPricing from '../components/MembershipPricing.astro';
import AdvancedTopicsTeaser from '../components/AdvancedTopicsTeaser.astro';
import heroImage from '../assets/photos/balint-cooking-action.jpeg';
import { SITE } from '../lib/site';
import { BIO_STATS, METHOD_PILLARS } from '../lib/program';

const allPosts = await getCollection('blog');
const latestPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const testimonialEntries = await getCollection('testimonials');
const methodIcons = ['book', 'shield', 'coin', 'salt', 'fat', 'acid', 'heat', 'leaf', 'plate', 'calendar', 'basket', 'clock'] as const;
---

<Layout
  title="Finomabb, egészségesebb főzés otthonodban"
  description="Heti max. 2 főzéssel, káoszmentesen — Kardos Bálint séf közösségével megtanulsz olcsóbban, gyorsabban és egészségesebben főzni, batch cooking módszerrel."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-sage-300">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:items-center md:px-6 md:py-24">
      <div>
        <p class="font-script text-3xl text-forest-700 mb-2">Kardos Bálint Okoskonyhája</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-forest-800 leading-tight mb-6">
          Főzz <span class="font-script text-clay-600">finomabbat</span> és egészségesebbet — olcsóbban és gyorsabban
        </h1>
        <p class="text-lg text-forest-800/90 mb-8 max-w-xl">
          Az Okoskonyha zárt közösségében megtanulod, hogyan oldd meg heti max. 2×2 óra főzéssel a heti
          főétkezéseidet — káoszmentesen, kajapánik nélkül.
        </p>
        <div class="flex flex-wrap gap-4">
          <CTAButton href={SITE.checkoutUrl} label="Csatlakozom most" size="lg" outbound trackingId="join_cta" />
          <CTAButton href="/okoskonyha/" label="Ismerd meg a közösséget" variant="ghost" size="lg" />
        </div>
        <p class="mt-4 text-sm text-forest-700">Bármikor lemondható. Nincs hosszú távú elköteleződés.</p>
      </div>
      <div class="relative">
        <Image src={heroImage} alt="Kardos Bálint főzés közben" width={600} height={600} loading="eager" fetchpriority="high" class="w-full rounded-3xl object-cover aspect-square" />
      </div>
    </div>
  </section>

  <!-- Pain -->
  <section class="mx-auto max-w-4xl px-4 py-16 text-center md:px-6">
    <SectionHeading eyebrow="Ismerős?" title="Minden nap ugyanaz a" accent="kérdés" />
    <p class="text-lg text-forest-600">
      Mi legyen ma ebédre? Mire hazaérsz a munkából, nincs kedved főzni; reggel meg, mire felkelsz, már
      nincs rá időd — így marad az olcsó, de egészségtelen gyorsétterem, vagy a minőségi, de drága
      rendelés. Tudod, hogy egészségesebben kéne enned, de recept helyett rendszer kellene.
    </p>
    <div class="mt-8">
      <CTAButton href="/okoskonyha/" label="Mutasd a megoldást" />
    </div>
  </section>

  <!-- Method teaser -->
  <section class="bg-sage-100 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SectionHeading eyebrow="A módszer" title="Amit a közösségben" accent="megtanulsz" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          METHOD_PILLARS.map((pillar, i) => (
            <div class="rounded-3xl bg-white p-6 shadow-sm shadow-forest-900/5">
              <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-sage-100 text-forest-700">
                <Icon name={methodIcons[i]} class="h-6 w-6" />
              </div>
              <h3 class="font-heading font-semibold text-forest-800 mb-1">{pillar.title}</h3>
              <p class="text-sm text-forest-600">{pillar.subtitle}</p>
            </div>
          ))
        }
      </div>
      <AdvancedTopicsTeaser />
      <div class="mt-10 text-center">
        <CTAButton href="/okoskonyha/" label="Ismerd meg a teljes rendszert" variant="ghost" />
      </div>
    </div>
  </section>

  <!-- Testimonialok -->
  <TestimonialCarousel items={testimonialEntries.map((t) => ({ name: t.data.name, role: t.data.role, quote: t.data.quote, avatar: t.data.avatar }))} />

  <!-- Pricing teaser -->
  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="Árazás" title="Válaszd ki, mi illik" accent="hozzád" />
    <MembershipPricing />
  </section>

  <!-- Bio / credibility -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <SectionHeading eyebrow="Ki vagyok én" title="Miért hallgass" accent="rám?" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        BIO_STATS.map((stat) => (
          <div class="rounded-2xl bg-sage-50 p-6 text-center">
            <p class="font-heading text-3xl font-semibold text-clay-500">{stat.value}</p>
            <p class="mt-1 text-sm text-forest-600">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <CTAButton href="/rolam/" label="Ismerd meg a teljes történetet" variant="ghost" />
    </div>
  </section>

  <!-- Legfrissebb blogposztok -->
  {
    latestPosts.length > 0 && (
      <section class="bg-sage-100 py-16 md:py-20">
        <div class="mx-auto max-w-6xl px-4 md:px-6">
          <SectionHeading eyebrow="A blogból" title="Nemrég írtam" accent="erről" align="left" />
          <div class="grid gap-6 md:grid-cols-3">
            {latestPosts.map((post) => <BlogCard post={post} />)}
          </div>
          <div class="mt-8 text-center">
            <CTAButton href="/blog/" label="Az összes bejegyzés" variant="ghost" />
          </div>
        </div>
      </section>
    )
  }

  <!-- Final CTA -->
  <section class="mx-auto max-w-4xl px-4 py-16 md:py-20 text-center md:px-6">
    <div class="rounded-3xl bg-clay-600 px-6 py-14 md:px-16">
      <h2 class="text-3xl md:text-4xl font-semibold text-cream mb-4">Készen állsz a csatlakozásra?</h2>
      <p class="text-cream/90 mb-8">Lépj be az Okoskonyhába, és kezdj el ma egyszerűbben, olcsóbban és egészségesebben főzni.</p>
      <CTAButton href={SITE.checkoutUrl} label="Csatlakozom az Okoskonyhához" variant="ghost" size="lg" outbound trackingId="join_cta" />
    </div>
  </section>
</Layout>
